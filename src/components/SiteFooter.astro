---
/**
 * Shared site footer — structured B2B layout (footer-v2)
 * Columns: Brand / Explore / Trust & Legal / Grievance Officer (DPDP 2023 mandatory)
 * App links use the data-app-href pattern (rewritten by scripts.js to ANALYZEG_APP_BASE).
 */
---
<footer class="footer footer-v2">
    <div class="container">
        <div class="footer-grid">
            <!-- Column 1: Brand -->
            <div class="footer-brand">
                <a href="/" class="footer-logo" aria-label="AnalyzeG home">
                    <img src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" alt="AnalyzeG" width="44" height="44" loading="lazy">
                    <span class="footer-logo-text">AnalyzeG</span>
                </a>
                <p class="footer-tagline">India's verified video review intelligence platform. Screened 30-second in-hand videos, Power BI dashboards, and raw data brands can verify themselves.</p>
                <div class="footer-social">
                    <a href="https://www.linkedin.com/company/analyzeg" target="_blank" rel="noopener noreferrer" aria-label="AnalyzeG on LinkedIn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                    </a>
                    <a href="https://github.com/souvik9434" target="_blank" rel="noopener noreferrer" aria-label="AnalyzeG on GitHub">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.13-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.295-1.552 3.3-1.23 3.3-1.23.665 1.652.254 2.873.13 3.176.767.84 1.236 1.91 1.236 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                    </a>
                </div>
                <div class="footer-app-ctas">
                    <a href="https://app.analyzeg.co.in/b2c-auth" data-app-href="/b2c-auth" class="footer-app-btn" rel="noopener">Sign Up as Reviewer</a>
                    <a href="https://app.analyzeg.co.in/b2b-auth" data-app-href="/b2b-auth" class="footer-app-btn footer-app-btn--brand" rel="noopener">Register Your Brand</a>
                </div>
            </div>

            <!-- Column 2: Explore -->
            <nav class="footer-links" aria-label="Explore">
                <h4>Explore</h4>
                <ul>
                    <li><a href="/features">Platform</a></li>
                    <li><a href="/for-reviewers">For Reviewers</a></li>
                    <li><a href="/about">About</a></li>
                    <li><a href="/analyzeg-faq">FAQ</a></li>
                    <li><a href="/blog/how-to-earn-from-video-reviews">Blog</a></li>
                    <li><a href="https://app.analyzeg.co.in/browse" data-app-href="/browse" rel="noopener">Browse Products</a></li>
                    <li><a href="https://app.analyzeg.co.in/how-it-works" data-app-href="/how-it-works" rel="noopener">How It Works</a></li>
                </ul>
            </nav>

            <!-- Column 3: Trust & Legal -->
            <nav class="footer-links" aria-label="Trust and Legal">
                <h4>Trust &amp; Legal</h4>
                <ul>
                    <li><a href="/trust">Trust Center</a></li>
                    <li><a href="/trust#verification">Verification Method</a></li>
                    <li><a href="/trust#consent">Consent &amp; Licensing</a></li>
                    <li><a href="/trust#access">Data &amp; Privacy Controls</a></li>
                    <li><a href="/trust#inventory">Inventory &amp; Delivery</a></li>
                    <li><a href="https://app.analyzeg.co.in/terms" data-app-href="/terms" rel="noopener">Terms of Service</a></li>
                    <li><a href="https://app.analyzeg.co.in/privacy" data-app-href="/privacy" rel="noopener">Privacy Policy</a></li>
                    <li><a href="https://app.analyzeg.co.in/refund" data-app-href="/refund" rel="noopener">Refund &amp; Cancellation</a></li>
                    <li><a href="https://app.analyzeg.co.in/disclaimer" data-app-href="/disclaimer" rel="noopener">Disclaimer</a></li>
                    <li><a href="https://app.analyzeg.co.in/cookies" data-app-href="/cookies" rel="noopener">Cookie Policy</a></li>
                </ul>
            </nav>

            <!-- Column 4: Grievance Officer (DPDP 2023 mandatory) -->
            <div class="footer-grievance">
                <h4>Grievance Officer</h4>
                <p><strong>Souvik Dey</strong> — Data Protection Officer</p>
                <p><a href="mailto:grievance@analyzeg.co.in">grievance@analyzeg.co.in</a></p>
                <p class="grievance-meta">Acknowledgment within 48 hours • Resolution within 90 days (DPDP Rules 2025)</p>
                <p class="grievance-meta">Business queries: <a href="mailto:support@analyzeg.co.in">support@analyzeg.co.in</a> — replies within 4 business hours.</p>
            </div>
        </div>

        <!-- Single trust strip: payments + security -->
        <div class="footer-pay">
            <div class="footer-pay-left">
                <span class="footer-pay-label">Accepted payments:</span>
                <span class="pay-chip"><img src="/assets/images/payment-logos/upi.png" alt="UPI" style="height:18px;" loading="lazy" draggable="false"></span>
                <span class="pay-chip"><img src="/assets/images/payment-logos/visa-blue.svg" alt="Visa" style="height:14px;" loading="lazy" draggable="false"></span>
                <span class="pay-chip"><img src="/assets/images/payment-logos/mastercard.png" alt="Mastercard" style="height:20px;" loading="lazy" draggable="false"></span>
                <span class="pay-chip"><img src="/assets/images/payment-logos/rupay.png" alt="RuPay" style="height:18px;" loading="lazy" draggable="false"></span>
                <a href="https://razorpay.com/" target="_blank" rel="noopener noreferrer" aria-label="Razorpay | Payment Gateway | Neobank" class="razorpay-badge">
                    <img src="https://badges.razorpay.com/badge-light.png" alt="Razorpay | Payment Gateway | Neobank" style="height:38px;" loading="lazy" referrerpolicy="origin">
                </a>
            </div>
            <div class="footer-pay-right">
                <span class="pay-secure">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
                    HTTPS/TLS Encrypted
                </span>
                <span aria-hidden="true">|</span>
                <span>Firebase &amp; Cloudflare Infrastructure</span>
            </div>
        </div>

        <!-- Single bottom bar -->
        <div class="footer-bottom-flex">
            <p>AnalyzeG is a brand owned and operated by Souvik Dey, Udyam MSME Registered, West Bengal, India. Data Fiduciary for DPDP Act 2023 purposes.</p>
            <span class="dpdp-badge">DPA available on request</span>
        </div>
    </div>
</footer>
