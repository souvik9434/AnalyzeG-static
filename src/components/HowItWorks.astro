---
import { AnimatedTimeline } from './AnimatedTimeline';
---
<section class="how-it-works" id="how-it-works" role="region" aria-labelledby="how-it-works-title">
  <div class="container">
    <h2 id="how-it-works-title" class="section-title" data-aos="fade-up">
      How AnalyzeG Works
    </h2>

    <!-- Reviewer Process -->
    <div id="reviewer-process" class="audience-section" data-audience="reviewer" role="tabpanel">
      <AnimatedTimeline client:only="react">
        <div class="process-steps">
          <div class="process-step" data-aos="fade-up">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <div class="step-content">
              <h3>1. Create Your AnalyzeG Profile</h3>
              <p>Sign up and complete verification to start earning.</p>
              <ul><li>Quick registration</li><li>Secure identity check</li><li>Set payout preference (UPI/bank)</li></ul>
            </div>
          </div>
          <div class="process-step" data-aos="fade-up" data-aos-delay="100">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </div>
            <div class="step-content">
              <h3>2. Record Reviews</h3>
              <p>Create authentic 30-sec in-hand video reviews.</p>
              <ul><li>Choose review opportunity</li><li>Follow checklist</li><li>Submit quality video</li></ul>
            </div>
          </div>
          <div class="process-step" data-aos="fade-up" data-aos-delay="200">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div class="step-content">
              <h3>3. Get Rewarded</h3>
              <p>Earn after 5-point verification.</p>
              <ul><li>Auto verification</li><li>Up to ₹40 after verification*</li><li>UPI / bank transfer</li></ul>
            </div>
          </div>
          <div class="process-step" data-aos="fade-up" data-aos-delay="300">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4"></path><path d="M12 18v4"></path><path d="M4.93 4.93l2.83 2.83"></path><path d="M16.24 16.24l2.83 2.83"></path><path d="M2 12h4"></path><path d="M18 12h4"></path><path d="M4.93 19.07l2.83-2.83"></path><path d="M16.24 7.76l2.83-2.83"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </div>
            <div class="step-content">
              <h3>4. Track Your Earnings</h3>
              <p>Real-time dashboard, payout within 24h of sale.</p>
              <ul><li>Live earnings dashboard</li><li>24h payout window</li><li>Review history</li></ul>
            </div>
          </div>
        </div>
      </AnimatedTimeline>
    </div>

    <!-- Brand Process -->
    <div id="brand-process" class="audience-section active" data-audience="brand" role="tabpanel">
      <AnimatedTimeline client:only="react">
        <div class="process-steps">
          <div class="process-step" data-aos="fade-up">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </div>
            <div class="step-content">
              <h3>1. Seamless Review Collection</h3>
              <p>High-quality in-hand videos at scale.</p>
              <ul><li>30-sec authentic videos</li><li>Structured survey responses</li><li>Real-time intake</li></ul>
            </div>
          </div>
          <div class="process-step" data-aos="fade-up" data-aos-delay="100">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
            </div>
            <div class="step-content">
              <h3>2. Data-Driven Analysis</h3>
              <p>Sentiment + themes + competitive benchmarking.</p>
              <ul><li>Sentiment & key themes</li><li>Pattern & trend detection</li><li>Competitor compare</li></ul>
            </div>
          </div>
          <div class="process-step" data-aos="fade-up" data-aos-delay="200">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
            </div>
            <div class="step-content">
              <h3>3. Interactive Dashboard</h3>
              <p>Power BI + raw data export.</p>
              <ul><li>Power BI dashboards</li><li>State/age/gender filters</li><li>CSV/Excel export</li></ul>
            </div>
          </div>
          <div class="process-step" data-aos="fade-up" data-aos-delay="300">
            <div class="step-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            </div>
            <div class="step-content">
              <h3>4. Strategic Implementation</h3>
              <p>From insights to action.</p>
              <ul><li>Performance dashboards</li><li>Competitive benchmarking</li><li>Product recommendations</li></ul>
            </div>
          </div>
        </div>
      </AnimatedTimeline>
    </div>
  </div>
</section>
