---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { AudienceSwitch } from '../components/AudienceSwitch';
import { AnimatedTimeline } from '../components/AnimatedTimeline';
import { TrustMarquee } from '../components/TrustMarquee';
import { StatsRow } from '../components/StatsRow';
import { FeatureHoverGrid } from '../components/FeatureHoverGrid';
---
<BaseLayout>
  <Fragment slot="head">
        <title>AnalyzeG — Verified Video Review Platform | Earn Money & Buy Reviews | India</title>
        <meta name="description" content="AnalyzeG is India's verified video review platform. Reviewers earn up to Rs 40 instant payout + 50% revenue share. Brands buy authentic 30-sec product videos with advanced analytics, Power BI dashboards, and competitor benchmarking." />
        <meta name="keywords" content="AnalyzeG, video review platform India, earn money from video reviews, paid video reviews, product review platform, B2B market intelligence, competitor analysis tool, authentic video reviews, video testimonials, customer feedback platform, review monetization, market research India, consumer insights, video analytics, competitor review analysis, advanced review analytics, Power BI dashboard reviews, verified reviews India, earn from product reviews, video review earn money online, market research platform India, brand review analytics, sentiment analysis reviews, dual-stage payout reviews, review verification platform" />
        <link rel="canonical" href="https://analyzeg.co.in/" />
        <link rel="alternate" hreflang="en-IN" href="https://analyzeg.co.in/" />
        <link rel="alternate" hreflang="en" href="https://analyzeg.co.in/" />
        <link rel="alternate" hreflang="x-default" href="https://analyzeg.co.in/" />

        <!-- Open Graph -->
        <meta property="og:title" content="AnalyzeG — Verified Video Review Platform | Earn & Buy Reviews" />
        <meta property="og:description" content="India's verified video review platform. Reviewers earn up to Rs 40 + 50% revenue share. Brands get authentic product videos with advanced analytics." />
        <meta property="og:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1600" />
        <meta property="og:image:height" content="1600" />
        <meta property="og:image:alt" content="AnalyzeG — Verified Video Review Intelligence Platform" />
        <meta property="og:url" content="https://analyzeg.co.in" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="AnalyzeG" />
        <meta property="og:locale" content="en_IN" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="AnalyzeG — Verified Video Review Platform" />
        <meta name="twitter:description" content="India's verified video review platform. Reviewers earn up to Rs 40 + 50% revenue share. Brands get authentic product videos with advanced analytics." />
        <meta name="twitter:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
        <meta name="twitter:image:alt" content="AnalyzeG — Verified Video Review Intelligence Platform" />
        <meta name="twitter:site" content="@AnalyzeG" />
        <meta name="twitter:creator" content="@AnalyzeG" />

        <!-- Stylesheets -->
        <link is:inline rel="stylesheet" href="/css/styles.css" />
        <link is:inline rel="stylesheet" href="/css/mobile-enhancements.css" />
        <link is:inline rel="stylesheet" href="/css/aos.css" />
        <link rel="preload" href="/assets/optimized/hero-bg.jpg" as="image" fetchpriority="high" />

        <!-- Organization Schema (comprehensive, search-engine optimized) -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Organization",
                "@id": "https://analyzeg.co.in/#organization",
                "url": "https://analyzeg.co.in/",
                "logo": {
                    "@type": "ImageObject",
                    "@id": "https://analyzeg.co.in/#logo",
                    "url": "https://analyzeg.co.in/assets/optimized/favicon-search-512.png",
                    "width": 512,
                    "height": 512,
                    "contentUrl": "https://analyzeg.co.in/assets/optimized/favicon-search-512.png",
                    "encodingFormat": "image/png",
                    "caption": "AnalyzeG — Verified Video Review Intelligence Platform"
                },
                "image": {
                    "@type": "ImageObject",
                    "url": "https://analyzeg.co.in/assets/optimized/favicon-search-512.png",
                    "width": 512,
                    "height": 512
                },
                "name": "AnalyzeG",
                "legalName": "AnalyzeG Technologies",
                "alternateName": ["AnalyzeG", "Analyze G", "AnalyzeG Platform", "AnalyzeG Video Reviews", "AnalyzeG Review Platform"],
                "brand": {
                    "@type": "Brand",
                    "name": "AnalyzeG"
                },
                "description": "AnalyzeG is India's verified video review intelligence platform. Reviewers earn up to Rs 40 after verification plus 50% revenue share when reviews are sold. Brands receive authentic 30-second product videos with advanced analytics, Power BI dashboards, and competitor benchmarking.",
                "url": "https://analyzeg.co.in",
                "sameAs": [
                    "https://www.linkedin.com/company/analyzeg",
                    "https://github.com/souvik9434"
                ],
                "founder": {
                    "@type": "Person",
                    "@id": "https://analyzeg.co.in/#founder",
                    "name": "Souvik Dey",
                    "jobTitle": "Founder & CEO",
                    "url": "https://www.linkedin.com/in/souvikdey1/",
                    "sameAs": [
                        "https://www.linkedin.com/in/souvikdey1/",
                        "https://github.com/souvik9434"
                    ]
                },
                "foundingDate": "2025",
                "areaServed": {
                    "@type": "Country",
                    "name": "India"
                },
                "serviceType": [
                    "Video Review Platform",
                    "Market Research",
                    "Consumer Insights",
                    "Review Monetization",
                    "Advanced Analytics"
                ],
                "knowsAbout": [
                    "Video Reviews",
                    "Market Research",
                    "Consumer Insights",
                    "Sentiment Analysis",
                    "Competitor Analysis",
                    "Review Monetization",
                    "B2B Analytics",
                    "B2C Review Earnings"
                ],
                "contactPoint": {
                    "@type": "ContactPoint",
                    "email": "support@analyzeg.co.in",
                    "contactType": "customer service",
                    "availableLanguage": ["English", "Hindi"]
                }
            }
        </script>

        <!-- WebSite Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "WebSite",
                "@id": "https://analyzeg.co.in/#website",
                "name": "AnalyzeG — Verified Video Review Intelligence Platform",
                "alternateName": "AnalyzeG",
                "url": "https://analyzeg.co.in",
                "description": "AnalyzeG provides instant video review intelligence for businesses and revenue opportunities for authentic reviewers in India.",
                "publisher": {
                    "@id": "https://analyzeg.co.in/#organization"
                },
                "inLanguage": "en-IN",
                "potentialAction": {
                    "@type": "SearchAction",
                    "target": "https://analyzeg.co.in/search?q={search_term_string}",
                    "query-input": "required name=search_term_string"
                }
            }
        </script>

        <!-- SoftwareApplication Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "SoftwareApplication",
                "name": "AnalyzeG — Video Review Platform",
                "applicationCategory": "BusinessApplication",
                "operatingSystem": "Web",
                "description": "AnalyzeG is a verified review platform offering advanced video review analytics for brands and dual-stage earnings for reviewers.",
                "url": "https://analyzeg.co.in",
                "downloadUrl": "https://analyzeg.netlify.app/",
                "publisher": {
                    "@id": "https://analyzeg.co.in/#organization"
                },
                "offers": {
                    "@type": "AggregateOffer",
                    "lowPrice": "0",
                    "highPrice": "1275000",
                    "priceCurrency": "INR",
                    "offerCount": "3",
                    "offers": [
                        {
                            "@type": "Offer",
                            "name": "Professional — 500 Reviews",
                            "price": "500000",
                            "priceCurrency": "INR",
                            "description": "500 verified in-hand product video reviews with Power BI dashboard"
                        },
                        {
                            "@type": "Offer",
                            "name": "Enterprise — 1000 Reviews",
                            "price": "900000",
                            "priceCurrency": "INR",
                            "description": "1000 verified video reviews with multi-region demographic analysis"
                        },
                        {
                            "@type": "Offer",
                            "name": "Market Leader — 1500 Reviews",
                            "price": "1275000",
                            "priceCurrency": "INR",
                            "description": "1500 verified video reviews with advanced sentiment analysis"
                        }
                    ]
                },
                "aggregateRating": {
                    "@type": "AggregateRating",
                    "ratingValue": "4.8",
                    "bestRating": "5",
                    "ratingCount": "150"
                }
            }
        </script>

        <!-- FAQPage Schema (homepage quick answers) -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": [
                    {
                        "@type": "Question",
                        "name": "What is AnalyzeG?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "AnalyzeG is India's verified video review intelligence platform. It connects brands with authentic consumer insights through verified video reviews. Reviewers earn money via a dual-stage payout model, and brands get real product videos with advanced analytics and Power BI dashboards."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "How much can I earn on AnalyzeG?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Reviewers on AnalyzeG can get up to Rs 40 after verification as an instant payout, plus receive the remaining amount from their 50% revenue share when the review is sold. No social media following is required."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "How do brands buy video reviews on AnalyzeG?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Brands can purchase verified video review packages starting at 500 reviews for Rs 5,00,000. Each package includes 30-second in-hand product videos, a Power BI dashboard, raw data export, demographic filtering, and video licensing for advertising use."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "What analytics does AnalyzeG provide to brands?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "AnalyzeG provides data-driven sentiment analysis, keyword trend detection, competitive benchmarking, demographic segmentation by state/age/gender, custom Power BI dashboards, and exportable reports for brand teams."
                        }
                    }
                ]
            }
        </script>

        <!-- BreadcrumbList Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [{
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://analyzeg.co.in"
                }]
            }
        </script>
  </Fragment>

        <a href="#main-content" class="skip-link">Skip to main content</a>
        <!-- Platform Status Banner -->
        <div style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); color: white;         padding: 10px 0; text-align: center; position: relative; z-index: 10; box-shadow: 0 4px 20px rgba(37,99,235,0.3);">
            <div class="container" style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0.5rem;">
                <span style="font-weight: 600; font-size: 1rem;">Platform Live Now</span>
                <a href="https://analyzeg.netlify.app/" data-app-href="/" rel="noopener" style="color:#fff;text-decoration:underline;font-weight:600;font-size:0.95rem;margin-left:0.5rem;">Open App &rarr;</a>
            </div>
        </div>
        
        <!-- Navigation -->
        <header class="navbar" role="banner">
            <div class="container">
                <div class="logo-container">
                    <a href="/" class="logo">
                        <img
                            src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg"
                            alt="AnalyzeG"
                            width="40"
                            height="40"
                        />
                        <span class="logo-text">AnalyzeG</span>
                    </a>
                </div>
                <button
                    class="mobile-menu-btn"
                    aria-label="Toggle navigation menu"
                    aria-expanded="false"
                    aria-controls="main-nav"
                    aria-haspopup="true"
                >
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <nav
                    id="main-nav"
                    aria-label="Main navigation"
                    role="navigation"
                    aria-hidden="true"
                >
                    <ul role="menubar">
                        <li role="none">
                            <a
                                href="/"
                                class="active"
                                role="menuitem"
                                aria-current="page"
                                >Home</a
                            >
                        </li>
                        <li role="none">
                            <a href="features.html" role="menuitem">Features</a>
                        </li>
                        <li role="none">
                            <a href="about.html" role="menuitem">About</a>
                        </li>
                        <li role="none">
                            <a href="earn-money-reviews.html" role="menuitem"
                                >Earn Money</a
                            >
                        </li>
                        <li role="none">
                            <a href="analyzeg-faq.html" role="menuitem">FAQ</a>
                        </li>
                        <li role="none">
                            <a href="https://analyzeg.netlify.app/" data-app-href="/" class="nav-cta" role="menuitem" rel="noopener">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                                Launch App
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </header>
        <main id="main-content">
        <!-- Hero Section -->
        <section class="hero" style="background-color: #1a1a2e;">
            <div class="hero-overlay" aria-hidden="true"></div>
            <div class="animated-objects" aria-hidden="true">
                <div
                    class="bg-object hexagon"
                    style="
                        top: 10%;
                        left: 15%;
                        --moveX: 15vw;
                        --moveY: -20vh;
                        animation-delay: 0.2s;
                        background: #f59e0b;
                    "
                ></div>
                <div
                    class="bg-object circle"
                    style="
                        top: 60%;
                        left: 5%;
                        --moveX: -15vw;
                        --moveY: 15vh;
                        animation-delay: 0.7s;
                        background: #8b5cf6;
                    "
                ></div>
                <div
                    class="bg-object triangle"
                    style="
                        top: 20%;
                        left: 80%;
                        --moveX: 10vw;
                        --moveY: 20vh;
                        animation-delay: 1.2s;
                        background: #10b981;
                    "
                ></div>

            </div>
            <div class="container">
                <div class="audience-toggle-container" data-aos="fade-up">
                    <AudienceSwitch client:load />
                </div>
                <!-- Reviewer Content -->
                <div
                    id="reviewer-content"
                    class="audience-section active"
                    data-audience="reviewer"
                >
                    <div class="hero-content" data-aos="fade-up">
                        <h1>AnalyzeG – Authentic Video Review Intelligence Platform</h1>
                        <p class="hero-tagline">
                            Record video reviews. Earn up to Rs 40 instantly + 50% revenue share when sold.
                        </p>
                        <div class="hero-cta">
                            <a
                                href="https://analyzeg.netlify.app/b2c-auth"
                                data-app-href="/b2c-auth"
                                class="btn-primary"
                                rel="noopener"
                                >Start Reviewing on AnalyzeG</a
                            >
                            <a href="earn-money-reviews.html" class="btn-secondary"
                                >How It Works</a
                            >
                        </div>
                    </div>
                </div>

                <!-- Brand Content -->
                <div
                    id="brand-content"
                    class="audience-section"
                    data-audience="brand"
                >
                    <div class="hero-content" data-aos="fade-up">
                        <h1>Buy Real Customer Video Reviews with AnalyzeG Analytics</h1>
                        <ul class="hero-tagline-list" data-aos="fade-up">
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                30-second in-hand product videos
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                State &amp; age filtering
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                Power BI dashboard + raw data included
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                Licensed for advertising (main brands)
                            </li>
                            <li>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                Delivered in 2 min – 24 hrs
                            </li>
                        </ul>
                        <div class="hero-cta">
                            <a href="https://analyzeg.netlify.app/b2b-auth" data-app-href="/b2b-auth" class="btn-primary" rel="noopener"
                                >Get Started as Brand</a
                            >
                            <a href="mailto:support@analyzeg.co.in?subject=Custom%20Pricing%20Inquiry%20—%20AnalyzeG&body=Hi%20AnalyzeG%20Team%0A%0AI%27m%20interested%20in%20purchasing%20video%20reviews%20for%20my%20brand.%20Please%20share%20custom%20pricing%20details.%0A%0ACompany%3A%0AIndustry%3A%0AReview%20Volume%3A%0A" class="btn-secondary"
                                >Request Custom Quote</a
                            >
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Audience-specific trust marquees -->
        <div class="audience-section active" data-audience="reviewer">
            <TrustMarquee client:load audience="reviewer" />
        </div>
        <div class="audience-section" data-audience="brand">
            <TrustMarquee client:load audience="brand" />
        </div>
        <!-- How It Works Section (Modified to use the same toggle from hero section) -->
        <section
            class="how-it-works"
            id="how-it-works"
            role="region"
            aria-labelledby="how-it-works-title"
        >
            <div class="container">
                <h2
                    id="how-it-works-title"
                    class="section-title"
                    data-aos="fade-up"
                >
                    How AnalyzeG Works
                </h2>

                <!-- Reviewer Process - Connects to the hero toggle -->
                <div
                    id="reviewer-process"
                    class="audience-section active"
                    data-audience="reviewer"
                    role="tabpanel"
                    aria-labelledby="reviewer-option"
                >
                    <AnimatedTimeline client:only="react">
                    <div class="process-steps">
                        <div class="process-step" data-aos="fade-up">
                            <div class="step-icon">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="40"
                                    height="40"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
                                    ></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </div>
                            <div class="step-content">
                                <h3>1. Create Your AnalyzeG Profile</h3>
                                <p>
                                    Sign up on AnalyzeG and complete profile verification to
                                    start earning.
                                </p>
                                <ul>
                                    <li>Quick registration process</li>
                                    <li>Secure identity verification</li>
                                    <li>Set up payment preferences</li>
                                </ul>
                            </div>
                        </div>

                        <div
                            class="process-step"
                            data-aos="fade-up"
                            data-aos-delay="100"
                        >
                            <div class="step-icon">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="40"
                                    height="40"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <rect
                                        x="2"
                                        y="3"
                                        width="20"
                                        height="14"
                                        rx="2"
                                    ></rect>
                                    <line x1="8" y1="21" x2="16" y2="21"></line>
                                    <line
                                        x1="12"
                                        y1="17"
                                        x2="12"
                                        y2="21"
                                    ></line>
                                </svg>
                            </div>
                            <div class="step-content">
                                <h3>2. Record Reviews</h3>
                                <p>
                                    Create authentic video reviews on AnalyzeG following our
                                    guidelines.
                                </p>
                                <ul>
                                    <li>Choose review opportunities</li>
                                    <li>Follow provided guidelines</li>
                                    <li>Submit quality content</li>
                                </ul>
                            </div>
                        </div>

                        <div
                            class="process-step"
                            data-aos="fade-up"
                            data-aos-delay="200"
                        >
                            <div class="step-icon">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="40"
                                    height="40"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <polyline
                                        points="20 6 9 17 4 12"
                                    ></polyline>
                                </svg>
                            </div>
                            <div class="step-content">
                                <h3>3. Get Rewarded</h3>
                                <p>
                                    Earn instant rewards for verified reviews.
                                </p>
                                <ul>
                                    <li>Automatic verification</li>
                                    <li>Get up to Rs 40 after verification</li>
                                    <li>Multiple payment options</li>
                                </ul>
                            </div>
                        </div>

                        <div
                            class="process-step"
                            data-aos="fade-up"
                            data-aos-delay="300"
                        >
                            <div class="step-icon">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="40"
                                    height="40"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path d="M6 3h12"></path>
                                    <path d="M6 8h12"></path>
                                    <path d="m6 13 8.5 8"></path>
                                    <path d="M6 13h3"></path>
                                    <path d="M9 13c6.667 0 6.667-10 0-10"></path>
                                </svg>
                            </div>
                            <div class="step-content">
                                <h3>4. Track Your Earnings</h3>
                                <p>
                                    Monitor your review performance and earnings in real-time.
                                </p>
                                <ul>
                                    <li>Real-time earnings dashboard</li>
                                    <li>Payment within 24 hours of purchase</li>
                                    <li>Review history & analytics</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    </AnimatedTimeline>
                </div>

                <!-- Brand Process - Connects to the hero toggle -->
                <div
                    id="brand-process"
                    class="audience-section"
                    data-audience="brand"
                    role="tabpanel"
                    aria-labelledby="brand-option"
                >
                    <AnimatedTimeline client:only="react">
                    <div class="process-steps">
                        <div class="process-step" data-aos="fade-up">
                            <div class="step-icon">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="40"
                                    height="40"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <rect
                                        x="2"
                                        y="3"
                                        width="20"
                                        height="14"
