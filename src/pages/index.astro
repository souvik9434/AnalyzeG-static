        <!-- B2B Pricing Section: visible per JTBD, no audience gating — procurement-ready -->
        <section id="b2b-pricing" class="b2b-pricing-section" style="background: white; padding: 80px 0;">
            <div class="container">
                <div style="text-align:center; margin-bottom:1rem;"><span style="display:inline-flex; align-items:center; gap:6px; background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; padding:6px 14px; border-radius:9999px; font-size:0.8rem; font-weight:700;">🏢 For Brands • GST Invoice • PO Workflow • DPA on Request</span></div>
