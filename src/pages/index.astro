                    "Video Review Intelligence",
                    "Market Research",
                    "Consumer Insights",
                    "Power BI Dashboards",
                    "Sentiment Analysis"
                ],
                "knowsAbout": [
                    "Video Reviews",
                    "Market Research",
                    "Consumer Insights",
                    "Sentiment Analysis",
                    "Competitor Benchmarking",
                    "Power BI",
                    "Verified Consumer Intelligence"
                ],
                "contactPoint": {
                    "@type": "ContactPoint",
                    "email": "support@analyzeg.co.in",
                    "contactType": "customer service",
                    "availableLanguage": ["English", "Hindi"]
                }
            }
        </script>

        <!-- WebSite Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "WebSite",
                "@id": "https://analyzeg.co.in/#website",
                "name": "AnalyzeG — Verified Video Review Intelligence Platform for Brands",
                "alternateName": "AnalyzeG",
                "url": "https://analyzeg.co.in",
                "description": "AnalyzeG is a verified video review intelligence platform for consumer brands in India — 500 to 1500 face-presence verified 30s videos with Power BI + raw CSV in 2 minutes to 24 hours.",
                "publisher": {
                    "@id": "https://analyzeg.co.in/#organization"
                },
                "inLanguage": "en-IN",
                "potentialAction": {
                    "@type": "SearchAction",
                    "target": "https://analyzeg.co.in/search?q={search_term_string}",
                    "query-input": "required name=search_term_string"
                }
            }
        </script>

        <!-- SoftwareApplication Schema (no fake rating) -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "SoftwareApplication",
                "name": "AnalyzeG — Video Review Intelligence Platform",
                "applicationCategory": "BusinessApplication",
                "operatingSystem": "Web",
                "description": "Verified video review intelligence for brands: 500-1500 face-presence verified 30s in-hand videos, Power BI dashboards, raw CSV/Excel with video links, ad licensing for own-product videos. Reviewers compensated via transparent revenue-share.",
                "url": "https://analyzeg.co.in",
                "downloadUrl": "https://app.analyzeg.co.in/",
                "publisher": {
                    "@id": "https://analyzeg.co.in/#organization"
                },
                "offers": {
                    "@type": "AggregateOffer",
                    "lowPrice": "500000",
                    "highPrice": "1275000",
                    "priceCurrency": "INR",
                    "offerCount": "3",
                    "offers": [
                        {
                            "@type": "Offer",
                            "name": "Professional — 500 Reviews",
                            "price": "500000",
                            "priceCurrency": "INR",
                            "description": "500 face-presence verified 30s in-hand videos + Power BI dashboard + raw CSV + ad licensing"
                        },
                        {
                            "@type": "Offer",
                            "name": "Enterprise — 1000 Reviews",
                            "price": "900000",
                            "priceCurrency": "INR",
                            "description": "1000 verified videos + multi-region demographic analysis + competitor benchmarking"
                        },
                        {
                            "@type": "Offer",
                            "name": "Market Leader — 1500 Reviews",
                            "price": "1275000",
                            "priceCurrency": "INR",
                            "description": "1500 verified videos + advanced sentiment & trend analysis + premium support"
                        }
                    ]
                }
            }
        </script>

        <!-- FAQPage Schema (B2B-first, GEO-optimized) -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": [
                    {
                        "@type": "Question",
                        "name": "What is AnalyzeG?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "AnalyzeG is a verified video review intelligence platform for consumer brands in India. Brands purchase 500 to 1500 face-presence verified 30-second in-hand product videos, filtered by state, age and gender, and receive Power BI dashboards, sentiment & keyword analytics, and a complete raw CSV/Excel export with video links in 2 minutes to 24 hours. Reviewers are verified via 5-point checks and compensated via revenue-share."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "How does AnalyzeG verify video reviews?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Every review passes 5-point verification — face-presence, device integrity, geo-consistency, content checklist, and timestamp validation — plus human moderation. Only verified reviews enter the sellable pool. Data is protected with AES-256 at rest, TLS 1.3 in transit, 180-day retention, and audit logs per Privacy v1.1_2026-09-02."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Can brands use AnalyzeG videos as advertisements?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Yes. When the video shows your own product, purchase includes a license to use the raw 30-second video as organic or paid ad creative. Competitor videos provide data insights only; video ad licensing applies solely to the main brand to protect rights. Separate reviewer consent is required — see Terms v1.1_2026-09-02."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "What do brands receive for ₹5,00,000?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "For ₹5,00,000 (₹1,000 per review, one-time, no subscription) you receive 500 face-presence verified 30-second videos, custom Power BI dashboard + template, analyzed metrics, raw CSV/Excel with video links, state/age/gender filtering, and video ad licensing for own-product videos. Delivery in 2 minutes to 24 hours with 50% advance via Razorpay/UPI and 50% on delivery. SLA: 24h or 10% credit."
                        }
                    }
                ]
            }
        </script>

        <!-- BreadcrumbList Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [{
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://analyzeg.co.in"
                }]
            }
        </script>
  </Fragment>

        <a href="#main-content" class="skip-link">Skip to main content</a>
        <!-- Platform Status Banner -->
        <div style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); color: white;         padding: 10px 0; text-align: center; position: relative; z-index: 10; box-shadow: 0 4px 20px rgba(37,99,235,0.3);">
            <div class="container" style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0.5rem;">
                <span style="font-weight: 600; font-size: 1rem;">Platform Live Now</span>
                <a href="https://app.analyzeg.co.in/" data-app-href="/" rel="noopener" style="color:#fff;text-decoration:underline;font-weight:600;font-size:0.95rem;margin-left:0.5rem;">Open App &rarr;</a>
            </div>
        </div>
        
        <!-- Navigation -->
        <header class="navbar" role="banner">
            <div class="container">
                <div class="logo-container">
                    <a href="/" class="logo">
                        <img
                            src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg"
                            alt="AnalyzeG"
                            width="40"
                            height="40"
                        />
                        <span class="logo-text">AnalyzeG</span>
                    </a>
                </div>
                <button
                    class="mobile-menu-btn"
                    aria-label="Toggle navigation menu"
                    aria-expanded="false"
                    aria-controls="main-nav"
                    aria-haspopup="true"
                >
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <nav
                    id="main-nav"
                    aria-label="Main navigation"
                    role="navigation"
                    aria-hidden="true"
                >
                    <ul role="menubar">
                        <li role="none">
                            <a
                                href="/"
                                class="active"
                                role="menuitem"
                                aria-current="page"
                                >Home</a
                            >
                        </li>
                        <li role="none">
                            <a href="features.html" role="menuitem">Platform</a>
                        </li>
                        <li role="none">
                            <a href="/for-reviewers/" role="menuitem">For Reviewers</a>
                        </li>
                        <li role="none">
