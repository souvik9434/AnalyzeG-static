---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { TrustMarquee } from '../components/TrustMarquee';
import { StatsRow } from '../components/StatsRow';
import { FeatureHoverGrid } from '../components/FeatureHoverGrid';
import HowItWorks from '../components/HowItWorks.astro';
---
<BaseLayout>
  <Fragment slot="head">
        <title>AnalyzeG — Verified Video Review Intelligence Platform for Brands | Power BI + Raw Data in 24h</title>
        <meta name="description" content="AnalyzeG is India's verified video review intelligence platform for consumer brands. Get face-presence verified 30s in-hand videos, state/age/gender filters, Power BI dashboards + raw CSV with video links. Projects starting at ₹5L. GST invoice, PO, DPA." />
        <meta name="keywords" content="AnalyzeG, video review intelligence platform India, consumer insights platform India, verified video reviews, Power BI dashboard reviews, sentiment analysis reviews, competitor benchmarking, market research platform India, brand review analytics, consumer intelligence, in-hand video reviews, review verification platform, video review analytics India" />
        <link rel="canonical" href="https://analyzeg.co.in/" />
        <link rel="alternate" hreflang="en-IN" href="https://analyzeg.co.in/" />
        <link rel="alternate" hreflang="en" href="https://analyzeg.co.in/" />
        <link rel="alternate" hreflang="x-default" href="https://analyzeg.co.in/" />

        <!-- Open Graph -->
        <meta property="og:title" content="AnalyzeG — Verified Video Review Intelligence for Brands" />
        <meta property="og:description" content="India's verified video review intelligence for consumer brands. Face-presence verified 30s videos, Power BI + raw CSV, ad licensing. Projects starting at ₹5L. GST invoice, PO, DPA." />
        <meta property="og:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1600" />
        <meta property="og:image:height" content="1600" />
        <meta property="og:image:alt" content="AnalyzeG — Verified Video Review Intelligence Platform" />
        <meta property="og:url" content="https://analyzeg.co.in" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="AnalyzeG" />
        <meta property="og:locale" content="en_IN" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="AnalyzeG — Verified Video Review Intelligence for Brands" />
        <meta name="twitter:description" content="Verified 30s in-hand videos with Power BI + raw CSV. Face-presence verified, state/age/gender filters, ad licensing. Projects starting at ₹5L." />
        <meta name="twitter:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
        <meta name="twitter:image:alt" content="AnalyzeG — Verified Video Review Intelligence Platform" />
        <meta name="twitter:site" content="@AnalyzeG" />
        <meta name="twitter:creator" content="@AnalyzeG" />

        <!-- Stylesheets -->
        <link is:inline rel="stylesheet" href="/css/styles.css" />
        <link is:inline rel="stylesheet" href="/css/mobile-enhancements.css" />
        <link is:inline rel="stylesheet" href="/css/aos.css" />
        <link rel="preload" href="/assets/optimized/hero-bg.jpg" as="image" fetchpriority="high" />

        <!-- Organization Schema (B2B-primary, DPDP-clean) -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Organization",
                "@id": "https://analyzeg.co.in/#organization",
                "url": "https://analyzeg.co.in/",
                "logo": {
                    "@type": "ImageObject",
                    "@id": "https://analyzeg.co.in/#logo",
                    "url": "https://analyzeg.co.in/assets/optimized/favicon-search-512.png",
                    "width": 512,
                    "height": 512,
                    "contentUrl": "https://analyzeg.co.in/assets/optimized/favicon-search-512.png",
                    "encodingFormat": "image/png",
                    "caption": "AnalyzeG — Verified Video Review Intelligence Platform"
                },
                "image": {
                    "@type": "ImageObject",
                    "url": "https://analyzeg.co.in/assets/optimized/favicon-search-512.png",
                    "width": 512,
                    "height": 512
                },
                "name": "AnalyzeG",
                "alternateName": ["AnalyzeG"],
                "brand": {
                    "@type": "Brand",
                    "name": "AnalyzeG"
                },
                "description": "AnalyzeG provides consumer brands in India with screened 30-second in-hand product videos, human moderation, Power BI analysis, competitor benchmarking, and gated raw CSV/Excel exports.",
                "sameAs": [
                    "https://www.linkedin.com/company/analyzeg",
                    "https://github.com/souvik9434"
                ],
                "founder": {
                    "@type": "Person",
                    "@id": "https://analyzeg.co.in/#founder",
                    "name": "Souvik Dey",
                    "jobTitle": "Founder",
                    "url": "https://www.linkedin.com/in/souvikdey1/",
                    "sameAs": [
                        "https://www.linkedin.com/in/souvikdey1/",
                        "https://github.com/souvik9434"
                    ]
                },
                "foundingDate": "2024",
                "areaServed": {
                    "@type": "Country",
                    "name": "India"
                },
                "serviceType": [
                    "Video Review Intelligence",
                    "Market Research",
                    "Consumer Insights",
                    "Power BI Dashboards",
                    "Sentiment Analysis"
                ],
                "knowsAbout": [
                    "Video Reviews",
                    "Market Research",
                    "Consumer Insights",
                    "Sentiment Analysis",
                    "Competitor Benchmarking",
                    "Power BI",
                    "Verified Consumer Intelligence"
                ],
                "contactPoint": {
                    "@type": "ContactPoint",
                    "email": "support@analyzeg.co.in",
                    "contactType": "customer service",
                    "availableLanguage": ["English", "Hindi"]
                }
            }
        </script>

        <!-- WebSite Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "WebSite",
                "@id": "https://analyzeg.co.in/#website",
                "name": "AnalyzeG — Verified Video Review Intelligence Platform for Brands",
                "alternateName": "AnalyzeG",
                "url": "https://analyzeg.co.in",
                "description": "AnalyzeG provides screened 30-second in-hand product videos, human moderation, Power BI analysis, competitor benchmarking, and gated raw CSV/Excel exports for consumer brands in India.",
                "publisher": {
                    "@id": "https://analyzeg.co.in/#organization"
                },
                "inLanguage": "en-IN"
            }
        </script>

        <!-- SoftwareApplication Schema (no fake rating) -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "SoftwareApplication",
                "name": "AnalyzeG — Video Review Intelligence Platform",
                "applicationCategory": "BusinessApplication",
                "operatingSystem": "Web",
                "description": "Verified video review intelligence for brands: 500-1500 face-presence verified 30s in-hand videos, Power BI dashboards, raw CSV/Excel with video links, ad licensing for own-product videos. Reviewers compensated via transparent revenue-share.",
                "url": "https://analyzeg.co.in",
                "downloadUrl": "https://app.analyzeg.co.in/",
                "publisher": {
                    "@id": "https://analyzeg.co.in/#organization"
                },
                "offers": {
                    "@type": "Offer",
                    "availability": "https://schema.org/InStock",
                    "priceCurrency": "INR",
                    "url": "https://analyzeg.co.in/#b2b-pricing",
                    "description": "Projects starting at ₹5L. Final quote after scoping call — GST invoice, PO workflow, DPA on request."
                }
            }
        </script>

        <!-- FAQPage Schema (B2B-first, GEO-optimized) -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": [
                    {
                        "@type": "Question",
                        "name": "What is AnalyzeG?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "AnalyzeG provides screened 30-second in-hand product videos, human moderation, state/age/gender filters, Power BI dashboards, sentiment and keyword analysis, competitor benchmarking, and a gated raw CSV/Excel export with controlled video links for Indian consumer brands."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "How does AnalyzeG verify video reviews?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Each review receives five screening checks: face-presence, device integrity, geo-consistency, content checklist, and timestamp validation, followed by human moderation. These controls reduce risk but do not independently prove identity, product ownership, or the truth of every product claim. Buyers can inspect the original video and gated raw export."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "Can brands use AnalyzeG videos as advertisements?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Yes. When the video shows your own product, purchase includes a license to use the raw 30-second video as organic or paid ad creative. Competitor videos provide data insights only; video ad licensing applies solely to the main brand to protect rights. Separate reviewer consent is required — see Terms v1.1_2026-09-02."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "What do brand projects start at?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Projects start at ₹5,00,000 (one-time dataset licensing, no subscription). Final quote depends on volume, categories, demographic filters and timeline — confirmed in writing before collection begins. Every project includes face-presence verified 30-second videos, Power BI dashboard + template, analyzed metrics, raw CSV/Excel with video links, and video ad licensing for own-product videos where reviewers opt in. GST invoice, PO workflow, DPA on request. Talk to the Research Lead for a scoped quote."
                        }
                    }
                ]
            }
        </script>

        <!-- BreadcrumbList Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [{
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://analyzeg.co.in"
                }]
            }
        </script>
  </Fragment>

        <a href="#main-content" class="skip-link">Skip to main content</a>
        <!-- Platform Status Banner -->
        <div style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); color: white;         padding: 10px 0; text-align: center; position: relative; z-index: 10; box-shadow: 0 4px 20px rgba(37,99,235,0.3);">
            <div class="container" style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0.5rem;">
                <span style="font-weight: 600; font-size: 1rem;">Platform Live Now</span>
                <a href="https://app.analyzeg.co.in/" data-app-href="/" rel="noopener" style="color:#fff;text-decoration:underline;font-weight:600;font-size:0.95rem;margin-left:0.5rem;">Open App &rarr;</a>
            </div>
        </div>
        
        <!-- Navigation -->
        <header class="navbar" role="banner">
            <div class="container">
                <div class="logo-container">
                    <a href="/" class="logo">
                        <img
                            src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg"
                            alt="AnalyzeG"
                            width="40"
                            height="40"
                        />
                        <span class="logo-text">AnalyzeG</span>
                    </a>
                </div>
                <button
                    class="mobile-menu-btn"
                    aria-label="Toggle navigation menu"
                    aria-expanded="false"
                    aria-controls="main-nav"
                    aria-haspopup="true"
                >
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <nav
                    id="main-nav"
                    aria-label="Main navigation"
                    role="navigation"
                    aria-hidden="true"
                >
                    <ul role="menubar">
                        <li role="none">
                            <a
                                href="/"
                                class="active"
                                role="menuitem"
                                aria-current="page"
                                >Home</a
                            >
                        </li>
                        <li role="none">
                            <a href="features.html" role="menuitem">Platform</a>
                        </li>
                        <li role="none">
                            <a href="/for-reviewers" role="menuitem">For Reviewers</a>
                        </li>
                        <li role="none">
                            <a href="about.html" role="menuitem">About</a>
                        </li>
                        <li role="none">
                            <a href="analyzeg-faq.html" role="menuitem">FAQ</a>
                        </li>
                        <li role="none">
                            <a href="#b2b-pricing" role="menuitem">Pricing</a>
                        </li>
                        <li role="none">
                            <a href="https://app.analyzeg.co.in/" data-app-href="/" class="nav-cta" role="menuitem" rel="noopener">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                                Launch App
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </header>
        <main id="main-content">
        <!-- Hero Section -->
        <section class="hero" style="background-color: #1a1a2e;">
            <div class="hero-overlay" aria-hidden="true"></div>
            <div class="container">
                <!-- Single JTBD hero: B2B primary (brand intelligence), B2C secondary band -->
                <div class="hero-content" data-aos="fade-up">
                        <h1 style="font-size:2.9rem; font-weight:800; line-height:1.15; letter-spacing:-0.02em; color:#fff; text-shadow:0 2px 16px rgba(0,0,0,0.55), 0 1px 3px rgba(0,0,0,0.4);" class="hero-title">Verified Video Review Intelligence for India's D2C &amp; Retail Brands</h1>
                        <p class="hero-tagline">
                            500 face-presence verified 30-second in-hand videos + Power BI dashboards + raw CSV/Excel with video links. Purchase available marketplace inventory in minutes; confirm custom requests before collection begins.
                        </p>
                        <p style="font-size:0.88rem; color:rgba(255,255,255,0.9); margin-top:0.6rem; max-width:680px; margin-left:auto; margin-right:auto; line-height:1.5;">Buy verified reviews already available in the AnalyzeG marketplace. Delivery is near-instant for in-stock datasets; requests requiring new collection or custom quotas are confirmed before purchase and delivered within the agreed SLA.</p>
                        <p style="font-size:0.8rem; opacity:0.85; margin-top:0.6rem; color:rgba(255,255,255,0.85);">5-point review screening: face-presence, device, geo, content, timestamp + human moderation. <a href="/trust.html#verification" style="color:#93c5fd; text-decoration:underline;">How verification works</a> • <a href="/trust.html#inventory" style="color:#93c5fd; text-decoration:underline;">View available categories and sample inventory →</a></p>
                        <div class="hero-cta">
                            <a href="#b2b-pricing" class="btn-primary">Browse Review Inventory →</a>
                            <a href="https://app.analyzeg.co.in/" data-app-href="/b2b-auth" rel="noopener" class="btn-secondary" style="background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.25);">Request Sample Data</a>
                            <a href="https://cal.com/analyzeg-demo" target="_blank" rel="noopener" class="btn-secondary">Book 15-min Demo</a>
                        </div>
                        <!-- Reviewer bridge — single subtle link (B2B primary, no payout number) -->
                        <div style="margin-top:1.4rem; display:inline-flex; align-items:center; gap:0.5rem; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.13); border-radius:9999px; padding:0.55rem 1rem; backdrop-filter: blur(8px);">
                            <span style="font-size:0.82rem; color:rgba(255,255,255,0.85);">Have a product experience to share?</span>
                            <a href="/for-reviewers" style="font-size:0.82rem; color:#fde68a; text-decoration:underline; font-weight:600;">Join the AnalyzeG reviewer community →</a>
                        </div>
                    </div>
            </div>
        </section>
        <!-- Sticky mobile CTA — B2B primary (brand pricing) -->
        <div class="sticky-cta" style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:999; background:#fff; border-top:1px solid #e2e8f0; box-shadow:0 -4px 20px rgba(0,0,0,0.08); padding:0.75rem 1rem; align-items:center; justify-content:space-between; gap:0.75rem;">
            <div style="min-width:0;"><div style="font-size:0.95rem; font-weight:700; color:#1e293b; white-space:nowrap;">500 Videos • Power BI • 24h</div><div style="font-size:0.75rem; color:#475569;">GST Invoice • From ₹5L</div></div>
            <a href="#b2b-pricing" style="flex-shrink:0; background:#2563EB; color:#fff; padding:0.7rem 1.25rem; border-radius:9999px; font-weight:700; font-size:0.9rem; text-decoration:none;">View Pricing →</a>
        </div>
        <style>
            @media (max-width: 768px) { .sticky-cta { display:flex !important; } body { padding-bottom: 72px; } }
            @media (prefers-reduced-motion: no-preference) { .sticky-cta { animation: slideUp 0.4s ease-out; } @keyframes slideUp { from{transform:translateY(100%)} to{transform:translateY(0)} } }
        </style>
        <!-- Brand trust marquee — B2B primary -->
        <TrustMarquee client:load audience="brand" />
        <HowItWorks />

        <!-- B2B Pain Point Comparison: visible above fold per 2026 best practice -->
        <section class="pain-point-comparison" style="background: linear-gradient(135deg, #f5f7fa 0%, #e3e7ef 100%); padding: 40px 0;">
            <div class="container">
                <h2 class="section-title" data-aos="fade-up" style="margin-bottom: 1rem;">Choose a Research Workflow That Fits the Decision</h2>
                <p style="text-align: center; max-width: 700px; margin: 0 auto 3rem; font-size: 1.1rem; color: #475569;">Compare timeline, evidence format, data access, and licensing before selecting a research partner.</p>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; margin-top: 3rem;">
                    <div data-aos="fade-right" style="background: white; border-radius: 16px; padding: 2.5rem; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 2px solid #fee2e2;">
                        <div style="background: #fee2e2; color: #dc2626; padding: 8px 16px; border-radius: 20px; font-size: 0.9rem; font-weight: 600; display: inline-block; margin-bottom: 1.5rem;">❌ The Old Way</div>
                        <h3 style="font-size: 1.5rem; margin-bottom: 1.5rem; color: #1e293b;">Scope-Dependent Research</h3>
                        <ul style="list-style: none; padding: 0;">
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid #f1f5f9; color: #475569;"><strong style="color: #1e293b;">Timeline:</strong> Defined in the proposal and statement of work</li>
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid #f1f5f9; color: #475569;"><strong style="color: #1e293b;">Cost:</strong> Custom quote based on method and sample</li>
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid #f1f5f9; color: #475569;"><strong style="color: #1e293b;">Deliverables:</strong> Agreed in the project scope</li>
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid #f1f5f9; color: #475569;"><strong style="color: #1e293b;">Video Access:</strong> Depends on package and licence</li>
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid #f1f5f9; color: #475569;"><strong style="color: #1e293b;">Raw Data:</strong> Request the available fields and format</li>
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid #f1f5f9; color: #475569;"><strong style="color: #1e293b;">Flexibility:</strong> Confirm revisions and exclusions in writing</li>
                            <li style="padding: 0.75rem 0; color: #475569;"><strong style="color: #1e293b;">Decision Use:</strong> Match the method to the research question</li>
                        </ul>
                    </div>
                    
                    <div data-aos="fade-left" style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); border-radius: 16px; padding: 2.5rem; box-shadow: 0 8px 30px rgba(37,99,235,0.3); position: relative;">
                        <div style="background: rgba(255,255,255,0.2); color: white; padding: 8px 16px; border-radius: 20px; font-size: 0.9rem; font-weight: 600; display: inline-block; margin-bottom: 1.5rem;">✅ The AnalyzeG Advantage</div>
                        <h3 style="font-size: 1.5rem; margin-bottom: 1.5rem; color: white;">Real Video Reviews with Complete Analytics</h3>
                        <ul style="list-style: none; padding: 0;">
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.95);"><strong style="color: white;">Timeline:</strong> In-stock datasets in minutes; custom collection per agreed SLA</li>
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.95);"><strong style="color: white;">Cost:</strong> Projects starting at ₹5L — final quote after scoping</li>
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.95);"><strong style="color: white;">Deliverables:</strong> Power BI dashboard + custom template</li>
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.95);"><strong style="color: white;">Video Access:</strong> 30-sec in-hand product videos</li>
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.95);"><strong style="color: white;">Raw Data:</strong> Secure video access links + raw CSV/Excel with role-based controls</li>
                            <li style="padding: 0.75rem 0; border-bottom: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.95);"><strong style="color: white;">Licensing:</strong> Commercial licence for own-product videos where reviewer opts in</li>
                            <li style="padding: 0.75rem 0; color: rgba(255,255,255,0.95);"><strong style="color: white;">Purchase:</strong> One-time dataset licensing — repeat purchase available</li>
                        </ul>
                        <div style="background: rgba(255,255,255,0.15); border-radius: 12px; padding: 1.5rem; margin-top: 2rem; border-left: 4px solid #fbbf24;">
                            <p style="color: white; margin: 0; font-weight: 500;">🎯 <strong>Optional dual use:</strong> Combine research insights with licensed advertising use for relevant own-product videos where the reviewer has opted in.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- B2B Pricing Section: visible per JTBD, no audience gating — procurement-ready -->
        <section id="b2b-pricing" class="b2b-pricing-section" style="background: white; padding: 80px 0;">
            <div class="container">
                <div style="text-align:center; margin-bottom:1rem;"><span style="display:inline-flex; align-items:center; gap:6px; background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; padding:6px 14px; border-radius:9999px; font-size:0.8rem; font-weight:700;">🏢 For Brands • GST Invoice • PO Workflow • DPA on Request</span></div>
                <h2 class="section-title" data-aos="fade-up">Projects Starting at ₹5L • Final Quote After Scoping</h2>
                <p style="text-align:center; max-width:720px; margin:0.4rem auto 0; font-size:0.88rem; color:#64748b;">One-time dataset licensing — in-stock delivery in minutes; custom quotas confirmed in writing before collection. <a href="/trust.html#inventory" style="color:#2563EB; text-decoration:underline;">Inventory &amp; delivery policy →</a></p>
                <p style="text-align: center; max-width: 700px; margin: 0 auto 3rem; font-size: 1.1rem; color: #475569;">GST invoice • PO accepted • DPA on request • Razorpay/UPI • Founder-led research support. Response target: 4 hours.</p>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-top: 3rem;">
                    <!-- Single anchor card: starting price only, full scope gated -->
                    <div data-aos="fade-up" style="background: white; border: 3px solid #2563EB; border-radius: 16px; padding: 2.5rem 2rem; box-shadow: 0 15px 50px rgba(37,99,235,0.2); position: relative; max-width:640px; margin:0 auto;">
                        <div style="background: #2563EB; color: white; padding: 8px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; display: inline-block; margin-bottom: 1.5rem;">FOR BRANDS</div>
                        <h3 style="font-size: 1.8rem; margin-bottom: 0.5rem; color: #1e293b;">Projects Starting at ₹5L</h3>
                        <div style="margin: 1.5rem 0;">
