        <title>AnalyzeG — Verified Video Review Intelligence Platform for Brands | Power BI + Raw Data in 24h</title>
        <meta name="description" content="AnalyzeG is India's verified video review intelligence platform for consumer brands. Get 500-1500 face-presence verified 30s in-hand videos, state/age/gender filters, Power BI dashboards + raw CSV with video links. Delivery 2 min to 24h. GST invoice, PO, DPA." />
        <meta name="keywords" content="AnalyzeG, video review intelligence platform India, consumer insights platform India, verified video reviews, Power BI dashboard reviews, sentiment analysis reviews, competitor benchmarking, market research platform India, brand review analytics, consumer intelligence, in-hand video reviews, review verification platform, video review analytics India" />
        <link rel="canonical" href="https://analyzeg.co.in/" />
        <link rel="alternate" hreflang="en-IN" href="https://analyzeg.co.in/" />
        <link rel="alternate" hreflang="en" href="https://analyzeg.co.in/" />
        <link rel="alternate" hreflang="x-default" href="https://analyzeg.co.in/" />

        <!-- Open Graph -->
        <meta property="og:title" content="AnalyzeG — Verified Video Review Intelligence for Brands" />
        <meta property="og:description" content="India's verified video review intelligence for consumer brands. 500-1500 face-presence verified 30s videos, Power BI + raw CSV, ad licensing. Delivered 2 min to 24h. GST invoice, PO, DPA." />
