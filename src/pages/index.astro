                "name": "AnalyzeG — Video Review Platform",
                "applicationCategory": "BusinessApplication",
                "operatingSystem": "Web",
                "description": "AnalyzeG is a verified review platform offering advanced video review analytics for brands and dual-stage earnings for reviewers.",
