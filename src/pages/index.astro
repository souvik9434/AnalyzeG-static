                        "@type": "Question",
                        "name": "What is AnalyzeG?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "AnalyzeG is India's verified video review intelligence platform. It connects brands with authentic consumer insights through verified video reviews. Reviewers earn money via a dual-stage payout model, and brands get real product videos with advanced analytics and Power BI dashboards."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "How much can I earn on AnalyzeG?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Reviewers on AnalyzeG can get up to ₹40 after verification as an instant payout, plus receive the remaining amount from their 50% revenue share when the review is sold. No social media following is required."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "How do brands buy video reviews on AnalyzeG?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "Brands can purchase verified video review packages starting at 500 reviews for ₹5,00,000. Each package includes 30-second in-hand product videos, a Power BI dashboard, raw data export, demographic filtering, and video licensing for advertising use."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "What analytics does AnalyzeG provide to brands?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "AnalyzeG provides data-driven sentiment analysis, keyword trend detection, competitive benchmarking, demographic segmentation by state/age/gender, custom Power BI dashboards, and exportable reports for brand teams."
                        }
                    }
                ]
            }
        </script>

        <!-- BreadcrumbList Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": [{
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://analyzeg.co.in"
                }]
            }
        </script>
