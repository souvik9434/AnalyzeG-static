        <!-- WebSite Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "WebSite",
                "@id": "https://analyzeg.co.in/#website",
                "name": "AnalyzeG — Verified Video Review Intelligence Platform",
                "alternateName": "AnalyzeG",
