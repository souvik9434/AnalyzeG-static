                "@context": "https://schema.org",
                "@type": "Organization",
                "@id": "https://analyzeg.co.in/#organization",
                "url": "https://analyzeg.co.in/",
                "logo": {
                    "@type": "ImageObject",
                    "@id": "https://analyzeg.co.in/#logo",
                    "url": "https://analyzeg.co.in/assets/optimized/favicon-search-512.png",
                    "width": 512,
                    "height": 512,
                    "contentUrl": "https://analyzeg.co.in/assets/optimized/favicon-search-512.png",
                    "encodingFormat": "image/png",
                    "caption": "AnalyzeG — Verified Video Review Intelligence Platform"
                },
                "image": {
                    "@type": "ImageObject",
                    "url": "https://analyzeg.co.in/assets/optimized/favicon-search-512.png",
