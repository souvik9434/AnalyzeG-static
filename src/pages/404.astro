---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout>
  <Fragment slot="head">

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' https: data: 'unsafe-inline'; script-src 'self' https: 'unsafe-inline'; style-src 'self' https: 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' https:; upgrade-insecure-requests;">
  <title>Page Not Found - AnalyzeG</title>
  
  <!-- SEO Meta Tags -->
  <meta name="robots" content="noindex, follow">
  <meta name="description" content="The page you requested could not be found. Navigate back to AnalyzeG's main site to explore our video review platform.">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="Page Not Found - AnalyzeG">
  <meta property="og:description" content="The page you requested could not be found. Navigate back to AnalyzeG's main site.">
  <meta property="og:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png">
  <meta property="og:url" content="https://analyzeg.co.in/404.html">
  <meta property="og:type" content="website">
  
  <!-- Stylesheets -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <link is:inline rel="stylesheet" href="/css/styles.css">
  
  <!-- Favicon -->
  
  <style>
    .error-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 70vh;
      text-align: center;
      padding: 2rem;
      margin-top: 70px;
    }
    
    .error-code {
      font-size: 8rem;
      font-weight: 800;
      margin: 0;
      background: linear-gradient(135deg, #2563EB, #7C3AED);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1;
    }
    
    .error-message {
      font-size: 2rem;
      margin: 1rem 0 2rem;
      color: #1a1a1a;
    }
    
    .error-description {
      font-size: 1.2rem;
      max-width: 600px;
      margin: 0 auto 2rem;
      color: #4b5563;
    }
    
    .error-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .error-actions .btn-secondary {
      background: #fff;
      color: #2563EB;
      border: 2px solid #e2e8f0;
      backdrop-filter: none;
    }
    .error-actions .btn-secondary:hover {
      background: #f8fafc;
      border-color: #2563EB;
      color: #1e40af;
    }
    
    @media (max-width: 768px) {
      .error-code {
        font-size: 6rem;
      }
      
      .error-message {
        font-size: 1.5rem;
      }
    }
  </style>

        <!-- Mirror the app domain favicon pattern so crawlers see the same dedicated 192px PNG asset -->
        <link rel="icon" type="image/png" sizes="512x512" href="/assets/optimized/favicon-search-512.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/assets/optimized/favicon-search-512.png" />
        <link rel="icon" type="image/svg+xml" href="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <!-- Brand identity meta tags -->
        <meta name="application-name" content="AnalyzeG" />
        <meta name="apple-mobile-web-app-title" content="AnalyzeG" />
        <meta name="msapplication-TileColor" content="#2563EB" />
        <meta name="msapplication-TileImage" content="https://analyzeg.co.in/assets/optimized/favicon-search-512.png" />
    
  </Fragment>

  <!-- Navigation -->
  <header class="navbar" role="banner">
    <div class="container">
      <div class="logo-container">
        <a href="/" class="logo">
          <img src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" alt="AnalyzeG" width="40" height="40">
          <span class="logo-text">AnalyzeG</span>
        </a>
      </div>
      <button class="mobile-menu-btn" 
              aria-label="Toggle navigation menu" 
              aria-expanded="false"
              aria-controls="main-nav"
              aria-haspopup="true">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav id="main-nav" 
           aria-label="Main navigation"
           role="navigation"
           aria-hidden="true">
        <ul role="menubar">
          <li role="none"><a href="/" role="menuitem">Home</a></li>
          <li role="none"><a href="features.html" role="menuitem">Features</a></li>
          <li role="none"><a href="about.html" role="menuitem">About</a></li>
          <li role="none"><a href="earn-money-reviews.html" role="menuitem">Earn Money</a></li>
          <li role="none"><a href="analyzeg-faq.html" role="menuitem">FAQ</a></li>
          <li role="none">
                            <a href="https://app.analyzeg.co.in/" data-app-href="/" class="nav-cta" role="menuitem" rel="noopener">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true"><path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 0 1 5.25 2h5.5A2.25 2.25 0 0 1 13 4.25v2a.75.75 0 0 1-1.5 0v-2a.75.75 0 0 0-.75-.75h-5.5a.75.75 0 0 0-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 0 0 .75-.75v-2a.75.75 0 0 1 1.5 0v2A2.25 2.25 0 0 1 10.75 18h-5.5A2.25 2.25 0 0 1 3 15.75V4.25Z" clip-rule="evenodd"/><path fill-rule="evenodd" d="M19 10a.75.75 0 0 0-.75-.75H8.704l1.048-.943a.75.75 0 1 0-1.004-1.114l-2.5 2.25a.75.75 0 0 0 0 1.114l2.5 2.25a.75.75 0 1 0 1.004-1.114l-1.048-.943h9.546A.75.75 0 0 0 19 10Z" clip-rule="evenodd"/></svg>
                                Launch App
                            </a>
                        </li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Error Content -->
  <main class="error-container">
    <h1 class="error-code">404</h1>
    <h2 class="error-message">Page Not Found</h2>
    <p class="error-description">The page you're looking for doesn't exist or has been moved. Please check the URL or navigate back to our home page.</p>
    <div class="error-actions">
      <a href="/" class="btn-primary">Go to Homepage</a>
      <a href="analyzeg-faq.html" class="btn-secondary">Visit FAQ</a>
    </div>
  </main>

  <!-- Footer -->
  <SiteFooter />

  <!-- Scripts -->
  <script is:inline src="/js/scripts.js"></script>

</BaseLayout>
