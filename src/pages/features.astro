---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { AudienceSwitch } from '../components/AudienceSwitch';
---
<BaseLayout>
  <Fragment slot="head">
  <title>AnalyzeG Features — Advanced Video Review Analytics, Dual-Stage Rewards, Custom Reports</title>
  <meta name="description" content="Explore AnalyzeG features: dual-stage reviewer rewards (₹40 instant + 50% revenue share), data-driven sentiment analysis, Power BI dashboards, competitor benchmarking, and data export for brands." />
  <meta name="keywords" content="AnalyzeG features, video review analytics, data-driven sentiment analysis, Power BI review dashboard, dual-stage rewards, competitor review analysis, market research features, review monetization platform, verified video reviews India, B2B review analytics, B2C earn money reviews, customer feedback analytics, video review platform features" />
  <link rel="canonical" href="https://analyzeg.co.in/features.html" />
  <link rel="alternate" hreflang="en" href="https://analyzeg.co.in/features.html" />
  <link rel="alternate" hreflang="en-IN" href="https://analyzeg.co.in/features.html" />
  <link rel="alternate" hreflang="x-default" href="https://analyzeg.co.in/features.html" />

  <!-- Open Graph -->
  <meta property="og:title" content="AnalyzeG Features — Advanced Video Review Analytics & Dual-Stage Rewards" />
  <meta property="og:description" content="Dual-stage rewards for reviewers, data-driven analytics for brands. Explore all AnalyzeG platform features." />
  <meta property="og:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
  <meta property="og:image:width" content="1600" />
  <meta property="og:image:height" content="1600" />
  <meta property="og:image:alt" content="AnalyzeG platform features — advanced video review analytics" />
  <meta property="og:url" content="https://analyzeg.co.in/features.html" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AnalyzeG" />
  <meta property="og:locale" content="en_IN" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="AnalyzeG Features — Advanced Video Review Analytics" />
  <meta name="twitter:description" content="Dual-stage rewards, data-driven sentiment analysis, Power BI dashboards, competitor benchmarking." />
  <meta name="twitter:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
  <meta name="twitter:image:alt" content="AnalyzeG platform features" />
  <meta name="twitter:site" content="@AnalyzeG" />
  <meta name="twitter:creator" content="@AnalyzeG" />

  <!-- Stylesheets -->
  <link is:inline rel="stylesheet" href="/css/styles.css" />
  <link is:inline rel="stylesheet" href="/css/mobile-enhancements.css" />
  <link is:inline rel="stylesheet" href="/css/aos.css" />
  </Fragment>

  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); color: white; padding: 10px 0; text-align: center; position: relative; z-index: 10;">
    <div class="container">
      <span style="font-weight: 600; font-size: 0.95rem;">Platform Live Now</span>
    </div>
  </div>

  <!-- Navigation -->
  <header class="navbar" role="banner">
    <div class="container">
      <div class="logo-container">
        <a href="/" class="logo">
          <img src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" alt="AnalyzeG" width="40" height="40">
          <span class="logo-text">AnalyzeG</span>
        </a>
      </div>
      <button class="mobile-menu-btn" 
              aria-label="Toggle navigation menu" 
              aria-expanded="false"
              aria-controls="main-nav"
              aria-haspopup="true">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav id="main-nav" 
           aria-label="Main navigation"
           role="navigation"
           aria-hidden="true">
        <ul role="menubar">
          <li role="none"><a href="/" role="menuitem">Home</a></li>
          <li role="none"><a href="features.html" class="active" role="menuitem" aria-current="page">Features</a></li>
          <li role="none"><a href="about.html" role="menuitem">About</a></li>
          <li role="none"><a href="earn-money-reviews.html" role="menuitem">Earn Money</a></li>
          <li role="none"><a href="analyzeg-faq.html" role="menuitem">FAQ</a></li>
          <li role="none"><a href="https://app.analyzeg.co.in/" data-app-href="/" class="nav-cta" role="menuitem" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg> Launch App</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main-content">
  <!-- Features Header — JTBD: outcome + proof -->
  <section class="page-header" data-aos="fade-in">
    <div class="bg-gradient-animated"></div>
    <div class="container">
      <h1 data-aos="zoom-in">From Video to Decision in One Platform</h1>
      <p data-aos="fade-up" data-aos-delay="200">Dual-stage payout for reviewers. Sentiment + Power BI + raw export for brands. No other Indian platform bundles all three.</p>
    </div>
  </section>

  <!-- Audience Toggle -->
  <div class="audience-toggle-container" data-aos="fade-up">
    <AudienceSwitch client:load />
  </div>

  <!-- Features Content -->
  <section class="features-content">
    <div class="container">
      <!-- Reviewer Features -->
      <div id="reviewer-content" class="audience-section active" data-audience="reviewer">
        <div class="feature-category" data-aos="fade-up">
          <h2>Earn & Engage</h2>
          <div class="feature-grid">
            <div class="feature-item" data-aos="fade-up">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M9 12l2 2 4-4"/>
                  <path d="M7 8h10M7 12h4m-4 4h2"/>
                </svg>
              </div>
              <h3>Dual-Stage Rewards</h3>
              <p>Limited-time flow: get up to ₹40 after authentic verification, then get the remaining payout from your 50% share when your review is sold.</p>
            </div>
            <div class="feature-item" data-aos="fade-up" data-aos-delay="100">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 3v19"/>
                  <path d="M5 20l7-7 7 7"/>
                  <path d="M5 16l7-7 7 7"/>
                  <path d="M5 12l7-7 7 7"/>
                </svg>
              </div>
              <h3>Regular Opportunities</h3>
              <p>Access a constant stream of review opportunities matched to your interests and expertise.</p>
            </div>
            <div class="feature-item" data-aos="fade-up" data-aos-delay="200">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                  <circle cx="12" cy="12" r="10"/>
                </svg>
              </div>
              <h3>Performance Tracking</h3>
              <p>Monitor your earnings, review stats, and reputation score through an intuitive dashboard.</p>
            </div>
          </div>
        </div>

        <div class="feature-category" data-aos="fade-up">
          <h2>User Experience</h2>
          <div class="feature-grid">
            <div class="feature-item" data-aos="fade-up">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="2" y="3" width="20" height="14" rx="2"/>
                  <path d="M8 21h8"/>
                  <path d="M12 17v4"/>
                  <circle cx="12" cy="10" r="3"/>
                  <path d="M12 13v2"/>
                </svg>
              </div>
              <h3>Simple Upload Process</h3>
              <p>Record and submit reviews easily through our mobile-friendly platform.</p>
            </div>
            <div class="feature-item" data-aos="fade-up" data-aos-delay="100">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <path d="M14 2v6h6"/>
                  <path d="M16 13H8"/>
                  <path d="M16 17H8"/>
                  <path d="M10 9H8"/>
                </svg>
              </div>
              <h3>Clear Guidelines</h3>
              <p>Get detailed instructions and tips for creating high-quality video reviews.</p>
            </div>
            <div class="feature-item" data-aos="fade-up" data-aos-delay="200">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M21 12a9 9 0 11-9-9c2.52 0 4.93 1.04 6.74 2.87"/>
                  <path d="M21 3v9h-9"/>
                  <path d="M11 12h2"/>
                  <path d="M11 16h2"/>
                </svg>
              </div>
              <h3>24/7 Support</h3>
              <p>Access dedicated support for technical assistance and review guidance.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Brand Features -->
      <div id="brand-content" class="audience-section" data-audience="brand">
        <div class="feature-category" data-aos="fade-up">
          <h2>Data & Analytics</h2>
          <div class="feature-grid">
            <div class="feature-item" data-aos="fade-up">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                  <polyline points="3.29 7 12 12 20.71 7"/>
                  <line x1="12" y1="22" x2="12" y2="12"/>
                </svg>
              </div>
              <h3>Consumer Intelligence</h3>
              <p>Access deep analytics including sentiment analysis, keyword trends, and demographic insights.</p>
            </div>
            <div class="feature-item" data-aos="fade-up" data-aos-delay="100">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M21 3v18"/>
                  <path d="M18 6l3-3 3 3"/>
                  <path d="M3 18a3 3 0 100 6 3 3 0 000-6z"/>
                  <path d="M12 8a3 3 0 100 6 3 3 0 000-6z"/>
                  <path d="M3 4a3 3 0 100 6 3 3 0 000-6z"/>
                  <line x1="3" y1="7" x2="3" y2="17"/>
                  <line x1="12" y1="11" x2="12" y2="21"/>
                </svg>
              </div>
              <h3>Custom Reports</h3>
              <p>Generate tailored reports with actionable insights for your marketing strategy.</p>
            </div>
            <div class="feature-item" data-aos="fade-up" data-aos-delay="200">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 22h14a2 2 0 002-2V7l-5-5H6a2 2 0 00-2 2v4"/>
                  <line x1="14" y1="2" x2="14" y2="7"/>
                  <line x1="14" y1="7" x2="19" y2="7"/>
                  <circle cx="6" cy="14" r="3"/>
                  <path d="M9 17l3 3"/>
                </svg>
              </div>
              <h3>Data Export</h3>
              <p>Export data in multiple formats or integrate directly through our API.</p>
            </div>
          </div>
        </div>

        <div class="feature-category" data-aos="fade-up">
          <h2>Platform Control</h2>
          <div class="feature-grid">
            <div class="feature-item" data-aos="fade-up">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 00-3-3.87"/>
                  <path d="M16 3.13a4 4 0 010 7.75"/>
                </svg>
              </div>
              <h3>Precise Targeting</h3>
              <p>Specify demographics, interests, and criteria for your ideal reviewers.</p>
            </div>
            <div class="feature-item" data-aos="fade-up" data-aos-delay="100">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <line x1="3" y1="9" x2="21" y2="9"/>
                  <line x1="9" y1="21" x2="9" y2="9"/>
                </svg>
              </div>
              <h3>Review Management</h3>
              <p>Track, moderate, and respond to reviews through a centralized dashboard.</p>
            </div>
            <div class="feature-item" data-aos="fade-up" data-aos-delay="200">
              <div class="feature-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  <polyline points="12 2 15.09 8.26 22 9.27"/>
                  <polyline points="22 9.27 17 14.14 18.18 21.02"/>
                  <polyline points="18.18 21.02 12 17.77 5.82 21.02"/>
                  <polyline points="5.82 21.02 7 14.14 2 9.27"/>
                  <polyline points="2 9.27 8.91 8.26 12 2"/>
                </svg>
              </div>
              <h3>Content Rights</h3>
              <p>Full rights to use verified reviews across your marketing channels.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- CTA Section -->
  <section class="cta" data-aos="fade-up">
    <div class="container">
      <!-- Reviewer CTA -->
      <div id="reviewer-cta" class="audience-section active" data-audience="reviewer">
        <h2>Ready to Start Earning?</h2>
        <p>Join our platform and start earning rewards for your authentic video reviews.</p>
        <div class="cta-buttons">
          <a href="https://app.analyzeg.co.in/b2c-auth" data-app-href="/b2c-auth" class="btn-primary" rel="noopener">Sign Up &amp; Start Earning</a>
          <a href="about.html" class="btn-secondary">Learn More</a>
        </div>
      </div>
      <!-- Brand CTA -->
      <div id="brand-cta" class="audience-section" data-audience="brand">
        <h2>Ready to Transform Your Customer Insights?</h2>
        <p>Get access to verified video reviews and data-driven analytics for your brand.</p>
        <div class="cta-buttons">
          <a href="https://app.analyzeg.co.in/b2b-auth" data-app-href="/b2b-auth" class="btn-primary" rel="noopener">Get Started as Brand</a>
          <a href="about.html" class="btn-secondary">Learn More</a>
        </div>
      </div>
    </div>
  </section>
  </main>
  <!-- Footer -->
  <SiteFooter />

  <!-- Organization Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://analyzeg.co.in/#organization",
    "name": "AnalyzeG",
    "url": "https://analyzeg.co.in",
    "logo": "https://analyzeg.co.in/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.png",
    "sameAs": [
      "https://www.linkedin.com/company/analyzeg",
      "https://github.com/souvik9434"
    ]
  }
  </script>

  <!-- WebPage Schema with Speakable -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://analyzeg.co.in/features.html/#webpage",
    "name": "AnalyzeG Platform Features — Advanced Video Review Analytics",
    "url": "https://analyzeg.co.in/features.html",
    "description": "Explore AnalyzeG features: dual-stage rewards, data-driven sentiment analysis, Power BI dashboards, competitor benchmarking, and data export.",
    "datePublished": "2025-12-01",
    "dateModified": "2026-08-27",
    "isPartOf": {
      "@id": "https://analyzeg.co.in/#website"
    },
    "about": {
      "@id": "https://analyzeg.co.in/#organization"
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://analyzeg.co.in"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Features",
          "item": "https://analyzeg.co.in/features.html"
        }
      ]
    },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["h1", ".feature-category h2", ".feature-item h3"]
    },
    "mainContentOfPage": {
      "@type": "WebPageElement",
      "cssSelector": ".features-content"
    }
  }
  </script>

</BaseLayout>
