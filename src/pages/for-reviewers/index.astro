---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { AnimatedTimeline } from '../../components/AnimatedTimeline';
---
<BaseLayout>
  <Fragment slot="head">
  <title>For Reviewers — Get Paid for Verified Video Reviews | AnalyzeG</title>
  <meta name="description" content="Join AnalyzeG as a reviewer. Record 30-second in-hand product videos, complete 5-point screening and human moderation, and access category-based paid opportunities. Current rates are shown in your reviewer account." />
  <meta name="keywords" content="AnalyzeG reviewers, earn money video reviews India, paid video reviews, 5-point verification, face-presence verified, UPI payout, revenue share reviews, video review side hustle" />
  <link rel="canonical" href="https://analyzeg.co.in/for-reviewers" />
  <link rel="alternate" hreflang="en" href="https://analyzeg.co.in/for-reviewers" />
  <link rel="alternate" hreflang="en-IN" href="https://analyzeg.co.in/for-reviewers" />
  <link rel="alternate" hreflang="x-default" href="https://analyzeg.co.in/for-reviewers" />

  <!-- Open Graph -->
  <meta property="og:title" content="For Reviewers — Your Voice, Heard by Brands | AnalyzeG" />
  <meta property="og:description" content="Get paid to share genuine product experiences. Complete 5-point screening and human moderation; current category rates are shown inside your reviewer account." />
  <meta property="og:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
  <meta property="og:image:width" content="1600" />
  <meta property="og:image:height" content="1600" />
  <meta property="og:image:alt" content="For Reviewers — AnalyzeG" />
  <meta property="og:url" content="https://analyzeg.co.in/for-reviewers" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AnalyzeG" />
  <meta property="og:locale" content="en_IN" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="For Reviewers — AnalyzeG" />
  <meta name="twitter:description" content="Record verified 30-second product videos, complete screening, and access paid category opportunities. Current rates appear in your reviewer account." />
  <meta name="twitter:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
  <meta name="twitter:image:alt" content="For Reviewers on AnalyzeG" />
  <meta name="twitter:site" content="@AnalyzeG" />
  <meta name="twitter:creator" content="@AnalyzeG" />

  <!-- Stylesheets -->
  <link is:inline rel="stylesheet" href="/css/styles.css" />
  <link is:inline rel="stylesheet" href="/css/mobile-enhancements.css" />
  <link is:inline rel="stylesheet" href="/css/aos.css" />
  </Fragment>

  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); color: white; padding: 10px 0; text-align: center; position: relative; z-index: 10;">
    <div class="container">
      <span style="font-weight: 600; font-size: 0.95rem;">Platform Live Now</span>
    </div>
  </div>

  <!-- Navigation -->
  <header class="navbar" role="banner">
    <div class="container">
      <div class="logo-container">
        <a href="/" class="logo">
          <img src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" alt="AnalyzeG" width="40" height="40">
          <span class="logo-text">AnalyzeG</span>
        </a>
      </div>
      <button class="mobile-menu-btn" 
              aria-label="Toggle navigation menu" 
              aria-expanded="false"
              aria-controls="main-nav"
              aria-haspopup="true">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav id="main-nav" 
           aria-label="Main navigation"
           role="navigation"
           aria-hidden="true">
        <ul role="menubar">
          <li role="none"><a href="/" role="menuitem">Home</a></li>
          <li role="none"><a href="features" role="menuitem">Platform</a></li>
          <li role="none"><a href="/for-reviewers" class="active" role="menuitem" aria-current="page">For Reviewers</a></li>
          <li role="none"><a href="about" role="menuitem">About</a></li>
          <li role="none"><a href="analyzeg-faq" role="menuitem">FAQ</a></li>
          <li role="none"><a href="/#b2b-pricing" role="menuitem">Pricing</a></li>
          <li role="none"><a href="https://app.analyzeg.co.in/" data-app-href="/" class="nav-cta" role="menuitem" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg> Launch App</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main-content">
  <!-- Hero Section — Mission + Honest Money -->
  <section class="page-header" data-aos="fade-in">
    <div class="bg-gradient-animated"></div>
    <div class="container">
      <h1 data-aos="zoom-in" data-aos-delay="200">Your Voice, Heard by the Brands That Make Your Products</h1>
      <p data-aos="fade-up" data-aos-delay="400">Get paid to share genuine product experiences. Submit a 30-second in-hand video, complete 5-point screening and human moderation, and access paid category opportunities.</p>
      <p data-aos="fade-up" data-aos-delay="500" style="font-size:0.85rem; opacity:0.85; margin-top:0.75rem;">5-point: face-presence, device, geo, content, timestamp + human moderation. <a href="/analyzeg-faq" style="color:#fff; text-decoration:underline;">How verification works</a> • <a href="#payouts" style="color:#fff; text-decoration:underline;">How payouts work</a></p>
      <div class="header-accent"></div>
    </div>
  </section>

  <!-- Canonical Payout Disclosure -->
  <section id="payouts" style="background:#f0fdf4; border-top:1px solid #bbf7d0; border-bottom:1px solid #bbf7d0; padding:2rem 0;">
    <div class="container" style="max-width:800px;">
      <div style="background:#fff; border:1px solid #bbf7d0; border-radius:12px; padding:1.5rem 1.75rem; box-shadow:0 2px 12px rgba(0,0,0,0.04);">
        <h2 style="font-size:1.15rem; font-weight:800; color:#166534; margin:0 0 0.75rem;">How payouts work — one place, linked everywhere</h2>
        <p style="margin:0 0 0.6rem; color:#334155; font-size:0.95rem;"><strong>Advance:</strong> Paid advance credited after your review passes 5-point verification + human moderation (in categories with active brand demand). <strong>Revenue share:</strong> When your review is purchased by a brand, you receive a share per sale — earn each time a brand buys. Exact amounts depend on category and demand and are shown inside your reviewer account after login.</p>
        <p style="margin:0; color:#334155; font-size:0.88rem;">Payout via UPI or bank within 24 hours of each sale event. T&amp;C apply. No followers needed. No fee to join. <a href="https://app.analyzeg.co.in/" data-app-href="/b2c-auth" rel="noopener" style="color:#2563EB; text-decoration:underline;">Log in to see your rates and Categories Needed Now</a>.</p>
      </div>
    </div>
  </section>

  <!-- Earnings Information -->
  <section class="earnings-info">
    <div class="container">
      <div class="earnings-grid">        <div class="earnings-card" data-aos="fade-up">
          <div class="earnings-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v4"></path>
              <path d="M12 18v4"></path>
              <path d="M4.93 4.93l2.83 2.83"></path>
              <path d="M16.24 16.24l2.83 2.83"></path>
              <path d="M2 12h4"></path>
              <path d="M18 12h4"></path>
              <path d="M4.93 19.07l2.83-2.83"></path>
              <path d="M16.24 7.76l2.83-2.83"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h2>Paid Category Opportunities</h2>
          <p>Eligible categories may offer an advance after verification and revenue share when a review is licensed. Current rates are shown inside your reviewer account before submission. <a href="#payouts" style="color:#2563eb; text-decoration:underline;">How it works</a></p>
        </div>
        
        <div class="earnings-card" data-aos="fade-up" data-aos-delay="100">
          <div class="earnings-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h2>5-Point Face-Presence Verification</h2>
          <p>Face-presence, device, geo, content &amp; timestamp + human moderation. Only verified reviews earn the advance and enter the brand pool.</p>
        </div>
        
        <div class="earnings-card" data-aos="fade-up" data-aos-delay="200">
          <div class="earnings-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <h2>Multiple Earnings</h2>
          <p>Submit reviews for multiple products to increase your total earnings over time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="how-it-works" id="how-it-works">
    <div class="container">
      <h2 class="section-title" data-aos="fade-up">How to Start Earning</h2>
      <p class="section-intro" data-aos="fade-up">Our streamlined process makes it easy to earn rewards for your authentic video reviews. Follow these simple steps:</p>
      
      <AnimatedTimeline client:only="react">
      <div class="process-steps">
        <div class="process-step" data-aos="fade-up">
          <div class="step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <div class="step-content">
            <h3>1. Create Your Profile</h3>
            <p>Set up your account in minutes and unlock review opportunities.</p>
            <ul>
              <li>Sign up with basic information</li>
              <li>Verify your identity securely</li>
              <li>Set up payment preferences</li>
            </ul>
          </div>
        </div>
        
        <div class="process-step" data-aos="fade-up" data-aos-delay="100">
          <div class="step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div class="step-content">
            <h3>2. Record Your Review</h3>
            <p>Share your honest opinion about products through video reviews.</p>
            <ul>
              <li>Choose from available review opportunities</li>
              <li>Record a 30-sec in-hand video review</li>
              <li>Answer quick survey questions</li>
            </ul>
          </div>
        </div>
        
        <div class="process-step" data-aos="fade-up" data-aos-delay="200">
          <div class="step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="step-content">
            <h3>3. Get Verified & Paid</h3>
            <p>Get verified fast and start receiving payouts in two stages.</p>
            <ul>
              <li>5-point screening and human moderation</li>
              <li>Eligible category advance after approval</li>
              <li>Revenue share when a review is licensed, at the rate shown in your account</li>
            </ul>
          </div>
        </div>
        
        <div class="process-step" data-aos="fade-up" data-aos-delay="300">
          <div class="step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
              <line x1="9" y1="9" x2="9.01" y2="9"></line>
              <line x1="15" y1="9" x2="15.01" y2="9"></line>
            </svg>
          </div>
          <div class="step-content">
            <h3>4. Earn Recurring Rewards</h3>
            <p>Continue earning as your reviews help businesses and consumers.</p>
            <ul>
              <li>Earn bonuses for high-quality reviews</li>
              <li>Unlock premium review opportunities</li>
              <li>Build your reviewer reputation score</li>
            </ul>
          </div>
        </div>
      </div>
      </AnimatedTimeline>
      
      <div class="cta-container" data-aos="fade-up">
        <a href="https://app.analyzeg.co.in/b2c-auth" data-app-href="/b2c-auth" class="btn-primary" rel="noopener">Start Earning Today</a>
      </div>
    </div>
  </section>

  <!-- Needed Now Bounty -->
  <section id="needed-now" style="background:#fff; padding:2.5rem 0; border-top:1px solid #e2e8f0;">
    <div class="container" style="max-width:800px;">
      <h2 style="font-size:1.25rem; font-weight:800; color:#1e293b; margin:0 0 0.5rem;">Categories Needed Now — See Active Opportunities</h2>
      <p style="color:#475569; font-size:0.95rem; margin:0 0 1rem;">Paid advance eligibility and current rates vary by category and active brand demand. Reviewers see the applicable rate inside their account before submitting an eligible review.</p>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
        <span style="background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; padding:6px 12px; border-radius:9999px; font-size:0.82rem; font-weight:600;">Audio &amp; Wearables</span>
        <span style="background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; padding:6px 12px; border-radius:9999px; font-size:0.82rem; font-weight:600;">Skincare &amp; Beauty</span>
        <span style="background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; padding:6px 12px; border-radius:9999px; font-size:0.82rem; font-weight:600;">Home &amp; Kitchen</span>
        <span style="background:#f0fdf4; border:1px solid #bbf7d0; color:#166534; padding:6px 12px; border-radius:9999px; font-size:0.82rem; font-weight:600;">Updated weekly</span>
      </div>
      <p style="font-size:0.8rem; color:#64748b; margin-top:0.75rem;">Full list in app: <a href="https://app.analyzeg.co.in/browse" data-app-href="/browse" style="color:#2563EB; text-decoration:underline;">Browse Products in App</a></p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <h2 class="section-title" data-aos="fade-up">Common Questions</h2>
      <div class="faq-grid">
        <div class="faq-item" data-aos="fade-up">
          <h3>How much can I earn?</h3>
          <p>Eligible categories may offer an advance after verification and revenue share when a review is licensed. Current category rates are shown inside your reviewer account. See <a href="#payouts" style="color:#2563EB; text-decoration:underline;">how payouts work</a>.</p>
        </div>
        
        <div class="faq-item" data-aos="fade-up" data-aos-delay="100">
          <h3>When do I get paid?</h3>
          <p>Eligible advances are credited after approval. Revenue share from a licensed review is processed within 24 hours of the eligible sale event. UPI or bank transfer.</p>
        </div>
        
        <div class="faq-item" data-aos="fade-up" data-aos-delay="200">
          <h3>What equipment do I need?</h3>
          <p>Just a smartphone with a decent camera and stable internet connection. We provide guidelines for optimal video quality.</p>
        </div>
        
        <div class="faq-item" data-aos="fade-up" data-aos-delay="300">
          <h3>How is authenticity verified?</h3>
          <p>Every review passes 5-point verification — face-presence, device, geo, content, timestamp — plus human moderation. Only verified reviews earn advance and enter the brand pool.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta" data-aos="fade-up">
    <div class="container">
      <h2>Ready to Start Earning?</h2>
      <p>Join the reviewer community and access paid opportunities for genuine product reviews.</p>
      <div class="cta-buttons">
        <a href="https://app.analyzeg.co.in/b2c-auth" data-app-href="/b2c-auth" class="btn-primary" rel="noopener">Sign Up &amp; Start Now</a>
        <a href="analyzeg-faq" class="btn-secondary">Learn More</a>
      </div>
    </div>
  </section>
  </main>
  <!-- Footer -->
  <SiteFooter />
  <!-- Scripts -->
  <script is:inline src="/js/aos.js"></script>
  <script is:inline src="/js/scripts.js"></script>

  <!-- WebPage Schema with Speakable -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://analyzeg.co.in/for-reviewers#webpage",
    "name": "For Reviewers — Your Voice, Heard by Brands | AnalyzeG",
    "url": "https://analyzeg.co.in/for-reviewers",
    "description": "Join AnalyzeG as a reviewer, complete 5-point screening and human moderation, and access paid category opportunities. Current rates are shown inside the reviewer account.",
    "datePublished": "2025-12-01",
    "dateModified": "2026-09-25",
    "isPartOf": {
      "@id": "https://analyzeg.co.in/#website"
    },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["h1", ".earnings-card h2", ".step-content h3"]
    }
  }
  </script>

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://analyzeg.co.in"},
      {"@type": "ListItem", "position": 2, "name": "For Reviewers", "item": "https://analyzeg.co.in/for-reviewers"}
    ]
  }
  </script>

</BaseLayout>
