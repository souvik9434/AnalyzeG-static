---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { AudienceSwitch } from '../components/AudienceSwitch';
import { FaqAccordion } from '../components/FaqAccordion';
---
<BaseLayout>
  <Fragment slot="head">
  <title>AnalyzeG FAQ — Video Review Payout, Verification, Brand Analytics | Answered</title>
  <meta name="description" content="AnalyzeG FAQ: Get clear answers about reviewer payouts (₹40 instant + 50% share), multi-factor verification, brand analytics, Power BI dashboards, data security, and video review pricing." />
  <meta name="keywords" content="AnalyzeG FAQ, video review payout, review verification process, brand analytics FAQ, earn money from reviews FAQ, video review platform questions, ₹40 payout, 50% revenue share, Power BI dashboard reviews, advanced review analytics FAQ" />
  <link rel="canonical" href="https://analyzeg.co.in/analyzeg-faq.html" />
  <link rel="alternate" hreflang="en" href="https://analyzeg.co.in/analyzeg-faq.html" />
  <link rel="alternate" hreflang="en-IN" href="https://analyzeg.co.in/analyzeg-faq.html" />
  <link rel="alternate" hreflang="x-default" href="https://analyzeg.co.in/analyzeg-faq.html" />

  <!-- Open Graph -->
  <meta property="og:title" content="AnalyzeG FAQ — Video Review Payout & Verification Explained" />
  <meta property="og:description" content="Get clear answers about AnalyzeG reviewer payouts, verification, brand analytics, and platform pricing." />
  <meta property="og:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
  <meta property="og:image:width" content="1600" />
  <meta property="og:image:height" content="1600" />
  <meta property="og:image:alt" content="AnalyzeG FAQ — Frequently Asked Questions" />
  <meta property="og:url" content="https://analyzeg.co.in/analyzeg-faq.html" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AnalyzeG" />
  <meta property="og:locale" content="en_IN" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="AnalyzeG FAQ — Payout, Verification & Analytics Explained" />
  <meta name="twitter:description" content="Get clear answers about reviewer payouts, verification, and brand analytics on AnalyzeG." />
  <meta name="twitter:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
  <meta name="twitter:image:alt" content="AnalyzeG FAQ" />
  <meta name="twitter:site" content="@AnalyzeG" />
  <meta name="twitter:creator" content="@AnalyzeG" />

  <!-- Stylesheets -->
  <link is:inline rel="stylesheet" href="/css/styles.css" />
  <link is:inline rel="stylesheet" href="/css/mobile-enhancements.css" />
  <link is:inline rel="stylesheet" href="/css/aos.css" />
  </Fragment>

  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); color: white; padding: 10px 0; text-align: center; position: relative; z-index: 10;">
    <div class="container">
      <span style="font-weight: 600; font-size: 0.95rem;">Platform Live Now</span>
    </div>
  </div>

  <!-- Navigation -->
  <header class="navbar" role="banner">
    <div class="container">
      <div class="logo-container">
        <a href="/" class="logo">
          <img src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" alt="AnalyzeG" width="40" height="40">
          <span class="logo-text">AnalyzeG</span>
        </a>
      </div>
      <button class="mobile-menu-btn" 
              aria-label="Toggle navigation menu" 
              aria-expanded="false"
              aria-controls="main-nav"
              aria-haspopup="true">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav id="main-nav" 
           aria-label="Main navigation"
           role="navigation"
           aria-hidden="true">
        <ul role="menubar">
          <li role="none"><a href="/" role="menuitem">Home</a></li>
          <li role="none"><a href="features.html" role="menuitem">Features</a></li>
          <li role="none"><a href="about.html" role="menuitem">About</a></li>
          <li role="none"><a href="earn-money-reviews.html" role="menuitem">Earn Money</a></li>
          <li role="none"><a href="analyzeg-faq.html" class="active" role="menuitem" aria-current="page">FAQ</a></li>
          <li role="none"><a href="https://app.analyzeg.co.in/" data-app-href="/" class="nav-cta" role="menuitem" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg> Launch App</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main-content">
  <!-- FAQ Header — JTBD: anxiety-first -->
  <section class="page-header" data-aos="fade-in">
    <div class="bg-gradient-animated"></div>
    <div class="container">
      <h1 data-aos="zoom-in">Payouts, Verification &amp; Data — Answered</h1>
      <p data-aos="fade-up" data-aos-delay="200">When do I get paid? How do you catch fakes? What do brands get? Search below or contact support.</p>
    </div>
  </section>

  <!-- Audience Toggle -->
  <div class="audience-toggle-container" data-aos="fade-up">
    <AudienceSwitch client:load />
  </div>

  <!-- FAQ Content -->
  <section class="faq-content">
    <div class="container">
      <!-- Reviewer FAQs -->
      <div id="reviewer-content" class="audience-section active" data-audience="reviewer">
        <FaqAccordion client:visible audience="reviewer" />
      </div>

      <!-- Brand FAQs -->
      <div id="brand-content" class="audience-section" data-audience="brand">
        <FaqAccordion client:visible audience="brand" />
      </div>
    </div>
  </section>
    </div>
  </section>

  <!-- Still Have Questions -->
  <section class="contact-cta" data-aos="fade-up">
    <div class="container">
      <h2>Still Have Questions?</h2>
      <p>Our support team is here to help. Contact us for personalized assistance.</p>
      <div class="cta-buttons">
        <a href="https://app.analyzeg.co.in/" data-app-href="/" class="btn-primary" rel="noopener">Launch App</a>
        <a href="about.html" class="btn-secondary">Learn More About Us</a>
      </div>
    </div>
  </section>
  </main>
  <!-- Footer -->
  <SiteFooter />
  <!-- FAQPage Schema (enhanced for search extraction) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much can I earn on AnalyzeG?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Limited-time model: you can get up to ₹40 after authentic verification. If your review is sold, you receive the remaining amount from your 50% share after subtracting the instant payout. No social media following is required."
        }
      },
      {
        "@type": "Question",
        "name": "When and how do I get paid on AnalyzeG?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can receive up to ₹40 soon after verification. The remaining payout is processed when your review is sold. Payment options include UPI, bank transfer, and wallet methods."
        }
      },
      {
        "@type": "Question",
        "name": "What equipment do I need to review on AnalyzeG?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A smartphone with a decent camera and stable internet connection is all you need. AnalyzeG provides guidelines for optimal video quality and review submission."
        }
      },
      {
        "@type": "Question",
        "name": "How does AnalyzeG verify review authenticity?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AnalyzeG uses advanced multi-factor verification to authenticate reviewer identity and content authenticity. Each review is digitally authenticated and securely recorded through multiple security checks, ensuring fair rewards and platform integrity."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a minimum payout threshold on AnalyzeG?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No strict minimum threshold. The instant payout can be up to ₹40 after verification, and the rest comes after your review is sold based on your 50% share."
        }
      },
      {
        "@type": "Question",
        "name": "How long should my video reviews be?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Videos should be 30-seconds long and cover key aspects of the product or service. AnalyzeG provides a checklist of points to cover for each review."
        }
      },
      {
        "@type": "Question",
        "name": "How quickly can brands receive reviews on AnalyzeG?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most review requests are fulfilled within 2 minutes to 24 hours. Brands receive notifications as reviews are submitted and verified."
        }
      },
      {
        "@type": "Question",
        "name": "How is brand data protected on AnalyzeG?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "All data is encrypted using bank-grade security. Access controls and audit logs ensure complete data privacy and compliance. AnalyzeG follows enterprise-grade security standards."
        }
      },
      {
        "@type": "Question",
        "name": "How much does AnalyzeG cost for brands?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AnalyzeG offers transparent one-time pricing: 500 reviews at ₹5,00,000 (₹1,000/review), 1,000 reviews at ₹9,00,000 (10% savings), and 1,500 reviews at ₹12,75,000 (15% savings). All packages include Power BI dashboards, raw data export, and video licensing."
        }
      },
      {
        "@type": "Question",
        "name": "What analytics do brands get on AnalyzeG?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Brands receive data-driven sentiment analysis, keyword trend detection, competitive benchmarking, demographic segmentation by state/age/gender, custom Power BI dashboards, and exportable CSV/Excel reports."
        }
      }
    ]
  }
  </script>

  <!-- WebPage Schema with Speakable -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://analyzeg.co.in/analyzeg-faq.html/#webpage",
    "name": "AnalyzeG FAQ — Video Review Payout, Verification & Analytics Explained",
    "url": "https://analyzeg.co.in/analyzeg-faq.html",
    "description": "Frequently asked questions about AnalyzeG reviewer payouts, verification, brand analytics, and platform pricing.",
    "datePublished": "2025-12-01",
    "dateModified": "2026-08-27",
    "isPartOf": {
      "@id": "https://analyzeg.co.in/#website"
    },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["h1", ".faq-content h3"]
    }
  }
  </script>

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://analyzeg.co.in"},
      {"@type": "ListItem", "position": 2, "name": "FAQ", "item": "https://analyzeg.co.in/analyzeg-faq.html"}
    ]
  }
  </script>

</BaseLayout>
