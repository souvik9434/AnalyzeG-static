---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout>
  <Fragment slot="head">
  <title>About AnalyzeG — India's Verified Video Review Intelligence Platform for Brands</title>
  <meta name="description" content="About AnalyzeG: India's verified video review intelligence platform for brands. Founded in 2024 by Souvik Dey — 5-point face-presence verification, Power BI dashboards, raw CSV with video links, DPDP 2023 compliant." />
  <meta name="keywords" content="about AnalyzeG, AnalyzeG team, Souvik Dey, video review platform India, verified reviews, consumer insights platform, market research India, review verification technology, advanced review analytics, brand review intelligence, earn money video reviews India" />
  <link rel="canonical" href="https://analyzeg.co.in/about" />
  <link rel="alternate" hreflang="en" href="https://analyzeg.co.in/about" />
  <link rel="alternate" hreflang="en-IN" href="https://analyzeg.co.in/about" />
  <link rel="alternate" hreflang="x-default" href="https://analyzeg.co.in/about" />

  <!-- Open Graph -->
  <meta property="og:title" content="About AnalyzeG — Verified Video Review Intelligence Platform" />
  <meta property="og:description" content="India's verified video review platform. Learn about our mission, team, and how we connect brands with authentic consumer insights." />
  <meta property="og:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
  <meta property="og:image:width" content="1600" />
  <meta property="og:image:height" content="1600" />
  <meta property="og:image:alt" content="About AnalyzeG — Verified Video Review Platform" />
  <meta property="og:url" content="https://analyzeg.co.in/about" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AnalyzeG" />
  <meta property="og:locale" content="en_IN" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="About AnalyzeG — Building Trust Through Authentic Reviews" />
  <meta name="twitter:description" content="Learn about AnalyzeG's mission to revolutionize video reviews with advanced verification and data-driven insights." />
  <meta name="twitter:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
  <meta name="twitter:image:alt" content="About AnalyzeG" />
  <meta name="twitter:site" content="@AnalyzeG" />
  <meta name="twitter:creator" content="@AnalyzeG" />

  <!-- Stylesheets -->
  <link is:inline rel="stylesheet" href="/css/styles.css" />
  <link is:inline rel="stylesheet" href="/css/mobile-enhancements.css" />
  <link is:inline rel="stylesheet" href="/css/aos.css" />
  <link rel="preload" href="/assets/optimized/about-bg.jpg" as="image" />
  </Fragment>

  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); color: white; padding: 10px 0; text-align: center; position: relative; z-index: 10;">
    <div class="container">
      <span style="font-weight: 600; font-size: 0.95rem;">Platform Live Now</span>
    </div>
  </div>

  <!-- Navigation Bar -->
  <header class="navbar" role="banner">
    <div class="container">
      <div class="logo-container">
        <a href="/" class="logo">
          <img src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" alt="AnalyzeG" width="40" height="40">
          <span class="logo-text">AnalyzeG</span>
        </a>
      </div>
      <button class="mobile-menu-btn" 
              aria-label="Toggle navigation menu" 
              aria-expanded="false"
              aria-controls="main-nav"
              aria-haspopup="true">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav id="main-nav" 
           aria-label="Main navigation"
           role="navigation"
           aria-hidden="true">
        <ul role="menubar">
          <li role="none"><a href="/" role="menuitem">Home</a></li>
          <li role="none"><a href="features" role="menuitem">Platform</a></li>
          <li role="none"><a href="/for-reviewers" role="menuitem">For Reviewers</a></li>
          <li role="none"><a href="about" class="active" role="menuitem" aria-current="page">About</a></li>
          <li role="none"><a href="analyzeg-faq" role="menuitem">FAQ</a></li>
          <li role="none"><a href="/#b2b-pricing" role="menuitem">Pricing</a></li>
          <li role="none"><a href="https://app.analyzeg.co.in/" data-app-href="/" class="nav-cta" role="menuitem" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg> Launch App</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main-content">
  <!-- About Page Header — JTBD: concrete proof over platitude -->
  <section class="page-header about-header" data-aos="fade-in">
    <div class="bg-overlay"></div>
    <div class="container">
      <h1 data-aos="zoom-in" data-aos-delay="200">Built for Verified Decisions</h1>
      <p data-aos="fade-up" data-aos-delay="400">We screen every 30-second in-hand video through five checks and human moderation, compensate eligible reviewers under published category terms, and give brands Power BI plus gated raw CSV with controlled video links.</p>
      <div class="header-accent"></div>
    </div>
  </section>

  <!-- About Content -->
  <section class="about-content">
    <div class="container" data-aos="fade-up">
      <article>
        <h2>Our Mission</h2>
        <p>AnalyzeG helps real people share honest video reviews and helps brands make better decisions through verified, data-driven insights. We believe trust is the foundation of every great product decision — and that trust starts with authentic voices. Our platform keeps the process simple, secure, and fair for everyone involved.</p>
      </article>

      <article data-aos="fade-up">
        <h2>Our Story</h2>
        <p>AnalyzeG was born from a simple frustration: market research is slow, expensive, and often unreliable. Traditional surveys and focus groups can't capture the raw honesty of someone holding a product in their hands and sharing their real experience.</p>
        <p>We built a platform where reviewers record short in-hand videos of products they use, and eligible reviews can support structured consumer research after screening and moderation. AnalyzeG is building a reviewer community across India while giving buyers raw data and controlled media access so they can evaluate the evidence for themselves.</p>
      </article>

      <article data-aos="fade-up">
        <h2>Our Values</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-top: 1rem;">
          <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #2563EB;">
            <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #1e40af;">Integrity</h3>
            <p style="font-size: 0.95rem; color: #475569; margin: 0;">Every review is screened and moderated. Verification reduces risk but does not guarantee identity, ownership, or the truth of every product claim.</p>
          </div>
          <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #8B5CF6;">
            <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #6D28D9;">Innovation</h3>
            <p style="font-size: 0.95rem; color: #475569; margin: 0;">Advanced analytics transforms raw video reviews into structured, actionable insights that traditional methods can't match.</p>
          </div>
          <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #10B981;">
            <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #059669;">Fairness</h3>
            <p style="font-size: 0.95rem; color: #475569; margin: 0;">Our dual-stage payout model ensures reviewers are rewarded fairly and transparently for their time and honest feedback.</p>
          </div>
          <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #F59E0B;">
            <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #D97706;">Transparency</h3>
            <p style="font-size: 0.95rem; color: #475569; margin: 0;">Clear rules, visible analytics, and open communication — both reviewers and brands always know exactly where they stand.</p>
          </div>
        </div>
      </article>

      <article data-aos="fade-up">
        <h2>What Brands Can Verify</h2>
        <ul role="list">
          <li>Five screening checks — face-presence, device, geo, content, timestamp — plus human moderation and audit logs</li>
          <li>Sentiment, keyword themes, and demographic segmentation alongside original in-hand video evidence</li>
          <li>Competitor benchmarking within the confirmed project scope</li>
          <li>Role-based access, time-bound video links, licence controls, and no reviewer contact details in buyer exports</li>
          <li>Gated raw CSV/Excel for independent analysis; advertising rights apply only where the relevant reviewer has opted in</li>
        </ul>
      </article>

      <article data-aos="fade-up">
        <h2>How Reviewer Payout Works</h2>
        <p>Eligible categories may offer a paid advance after screening and human moderation, plus revenue share when a review is licensed. Reviewers see the current category rate and terms inside their account before submitting an eligible review. Eligible payouts are sent by UPI or bank transfer. See <a href="/for-reviewers#payouts" style="color:#2563EB; text-decoration:underline;">how payouts work</a>.</p>
      </article>

      <article data-aos="fade-up">
        <h2>Founder</h2>
        <p>AnalyzeG is built and operated by Souvik Dey, a student founder focused on consumer research, data systems, and trustworthy review workflows.</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 2rem;">
          <div style="background: white; border-radius: 12px; padding: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.05); text-align: center; border: 1px solid #f1f5f9;">
            <div style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #2563EB 0%, #7C3AED 100%); margin: 0 auto 1rem; display: flex; align-items: center; justify-content: center; overflow: hidden; color: white; font-size: 2rem; font-weight: 700;">
              SD
            </div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.25rem; color: #1e293b;">Souvik Dey</h3>
            <p style="color: #475569; font-size: 0.95rem; margin-bottom: 0.5rem;">Founder</p>
            <p style="color: #64748b; font-size: 0.85rem; margin-bottom: 1rem; font-style: italic;">Student founder • Consumer research and data systems</p>
            <a href="https://www.linkedin.com/in/souvikdey1/" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.5rem; color: #0a66c2; text-decoration: none; font-weight: 500; font-size: 0.95rem; background:#eff6ff; padding:0.5rem 1rem; border-radius:8px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              Verify on LinkedIn
            </a>
          </div>
        </div>
      </article>

      <article data-aos="fade-up">
        <h2>Contact &amp; Support</h2>
        <p>Have questions about AnalyzeG? We're here to help.</p>
        <ul role="list">
          <li><strong>Email:</strong> support@analyzeg.co.in</li>
          <li><strong>Platform:</strong> <a href="https://app.analyzeg.co.in/" rel="noopener">app.analyzeg.co.in</a></li>
          <li><strong>FAQ:</strong> <a href="analyzeg-faq">Frequently Asked Questions</a></li>
        </ul>
      </article>
    </div>
  </section>
  </main>
  <!-- Footer -->
  <SiteFooter />

