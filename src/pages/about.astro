  <!-- Person Schema for Founder -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://analyzeg.co.in/#founder",
    "name": "Souvik Dey",
    "jobTitle": "Founder & CEO",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://analyzeg.co.in/#organization",
      "name": "AnalyzeG"
    },
    "url": "https://www.linkedin.com/in/souvikdey1/",
    "sameAs": [
      "https://www.linkedin.com/in/souvikdey1/",
      "https://github.com/souvik9434"
    ]
  }
  </script>

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://analyzeg.co.in"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "About",
        "item": "https://analyzeg.co.in/about.html"
      }
    ]
  }
