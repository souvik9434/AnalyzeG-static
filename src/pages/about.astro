---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout>
  <Fragment slot="head">

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self' https: data: 'unsafe-inline'; script-src 'self' https: 'unsafe-inline'; style-src 'self' https: 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' https:; upgrade-insecure-requests;">  <title>About AnalyzeG - Live Verified Review Platform</title>
  
  <!-- SEO Meta Tags -->
  <meta name="description" content="About AnalyzeG: a live verified review platform where people share honest video reviews and earn through a dual-stage payout model.">
  <meta name="keywords" content="about AnalyzeG, competitor review analysis, earn money reviews, video review platform, B2B B2C reviews">
  <meta name="robots" content="index, follow">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="About AnalyzeG - Live Verified Review Platform">
  <meta property="og:description" content="AnalyzeG helps brands get verified insights and helps reviewers earn with a clear dual-stage payout model.">
  <meta property="og:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png">
  <meta property="og:image:width" content="1600">
  <meta property="og:image:height" content="1600">
  <meta property="og:image:alt" content="AnalyzeG verified review platform logo">
  <meta property="og:url" content="https://analyzeg.co.in/about.html">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="AnalyzeG">
  <meta property="og:locale" content="en_IN">
  
  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="About AnalyzeG - Building Trust Through Authentic Reviews">
  <meta name="twitter:description" content="Learn about AnalyzeG's mission to revolutionize video reviews with advanced verification, user rewards, and data-driven insights.">
  <meta name="twitter:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png">
  <meta name="twitter:image:alt" content="AnalyzeG verified review platform logo">
  <meta name="twitter:site" content="@AnalyzeG">
  <meta name="twitter:creator" content="@AnalyzeG">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="https://analyzeg.co.in/about.html">
  
  <!-- Preconnect to External Resources -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- Stylesheets -->
  <!-- Non-blocking Google Fonts: onload swap prevents render-blocking; display=swap handles FOUT -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"></noscript>
  <link is:inline rel="stylesheet" href="/css/styles.css">
  <link is:inline rel="stylesheet" href="/css/mobile-enhancements.css">
  <!-- AOS CSS (self-hosted) -->
  <link is:inline rel="stylesheet" href="/css/aos.css">
  
  <!-- Favicon -->
  
  <!-- Preload Critical Resources -->
  <link rel="preload" href="/assets/optimized/about-bg.jpg" as="image">

        <!-- Mirror the app domain favicon pattern so crawlers see the same dedicated 192px PNG asset -->
        <link rel="icon" type="image/png" sizes="512x512" href="/assets/optimized/favicon-search-512.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/assets/optimized/favicon-search-512.png" />
        <link rel="icon" type="image/svg+xml" href="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <!-- Brand identity meta tags for SEO and entity recognition -->
        <meta name="application-name" content="AnalyzeG" />
        <meta name="apple-mobile-web-app-title" content="AnalyzeG" />
        <meta name="msapplication-TileColor" content="#2563EB" />
        <meta name="msapplication-TileImage" content="https://analyzeg.co.in/assets/optimized/favicon-search-512.png" />
    
  </Fragment>

  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); color: white; padding: 10px 0; text-align: center; position: relative; z-index: 10;">
    <div class="container">
      <span style="font-weight: 600; font-size: 0.95rem;">Platform Live Now</span>
    </div>
  </div>

  <!-- Navigation Bar -->
  <header class="navbar" role="banner">
    <div class="container">
      <div class="logo-container">
        <a href="/" class="logo">
          <img src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" alt="AnalyzeG" width="40" height="40">
          <span class="logo-text">AnalyzeG</span>
        </a>
      </div>
      <button class="mobile-menu-btn" 
              aria-label="Toggle navigation menu" 
              aria-expanded="false"
              aria-controls="main-nav"
              aria-haspopup="true">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav id="main-nav" 
           aria-label="Main navigation"
           role="navigation"
           aria-hidden="true">
        <ul role="menubar">
          <li role="none"><a href="/" role="menuitem">Home</a></li>
          <li role="none"><a href="features.html" role="menuitem">Features</a></li>
          <li role="none"><a href="about.html" class="active" role="menuitem" aria-current="page">About</a></li>
          <li role="none"><a href="earn-money-reviews.html" role="menuitem">Earn Money</a></li>
          <li role="none"><a href="analyzeg-faq.html" role="menuitem">FAQ</a></li>
          <li role="none"><a href="https://analyzeg.netlify.app/" data-app-href="/" class="nav-cta" role="menuitem" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg> Launch App</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main-content">
  <!-- About Page Header with Background Image -->
  <section class="page-header about-header" data-aos="fade-in">
    <div class="bg-overlay"></div>
    <div class="light-rays"></div>
    <div class="animated-objects">      <div class="bg-object hexagon" style="top: 20%; left: 25%; --moveX: 15vw; --moveY: -25vh; animation-delay: 0.2s; background: #4F46E5;"></div>
      <div class="bg-object circle" style="top: 70%; left: 10%; --moveX: -20vw; --moveY: 20vh; animation-delay: 0.7s; background: #EC4899;"></div>
      <div class="bg-object triangle" style="top: 10%; left: 75%; --moveX: 25vw; --moveY: 15vh; animation-delay: 1.2s; background: #06B6D4;"></div>
    </div>
    <div class="container">
      <h1 data-aos="zoom-in" data-aos-delay="200">About AnalyzeG</h1>
      <p data-aos="fade-up" data-aos-delay="400">Live platform for honest reviews, clear payouts, and trusted business insights.</p>
      <div class="header-accent"></div>
    </div>
  </section>

  <!-- About Content -->
  <section class="about-content">
    <div class="container" data-aos="fade-up">
      <article>
        <h2>Our Mission</h2>
        <p>AnalyzeG helps real people share honest video reviews and helps brands make better decisions through verified, AI-powered insights. We believe trust is the foundation of every great product decision — and that trust starts with authentic voices. Our platform keeps the process simple, secure, and fair for everyone involved.</p>
      </article>

      <article data-aos="fade-up">
        <h2>Our Story</h2>
        <p>AnalyzeG was born from a simple frustration: market research is slow, expensive, and often unreliable. Traditional surveys and focus groups can't capture the raw honesty of someone holding a product in their hands and sharing their real experience.</p>
        <p>We built a platform where reviewers record short video reviews of products they genuinely use, and brands get access to unfiltered, verified consumer insights — powered by AI analysis that turns raw video into actionable data. Today, AnalyzeG connects thousands of reviewers with brands across India, creating a win-win ecosystem where authentic voices earn money and businesses make smarter decisions.</p>
      </article>

      <article data-aos="fade-up">
        <h2>Our Values</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-top: 1rem;">
          <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #2563EB;">
            <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #1e40af;">Integrity</h3>
            <p style="font-size: 0.95rem; color: #475569; margin: 0;">Every review is verified for authenticity. We never compromise on the truthfulness of the feedback our platform delivers.</p>
          </div>
          <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #8B5CF6;">
            <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #6D28D9;">Innovation</h3>
            <p style="font-size: 0.95rem; color: #475569; margin: 0;">AI-powered analysis transforms raw video reviews into structured, actionable insights that traditional methods can't match.</p>
          </div>
          <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #10B981;">
            <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #059669;">Fairness</h3>
            <p style="font-size: 0.95rem; color: #475569; margin: 0;">Our dual-stage payout model ensures reviewers are rewarded fairly and transparently for their time and honest feedback.</p>
          </div>
          <div style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 12px rgba(0,0,0,0.06); border-left: 4px solid #F59E0B;">
            <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #D97706;">Transparency</h3>
            <p style="font-size: 0.95rem; color: #475569; margin: 0;">Clear rules, visible analytics, and open communication — both reviewers and brands always know exactly where they stand.</p>
          </div>
        </div>
      </article>

      <article data-aos="fade-up">
        <h2>Why Brands Trust AnalyzeG</h2>
        <ul role="list">
          <li>Multi-factor verification confirms every reviewer and every review is authentic</li>
          <li>AI-powered sentiment analysis delivers deeper insights than traditional surveys</li>
          <li>Competitive benchmarking tools let brands compare against industry rivals</li>
          <li>Enterprise-grade data security protects all review data and brand information</li>
          <li>Trusted by growing brands across India for real-time consumer intelligence</li>
        </ul>
      </article>

      <article data-aos="fade-up">
        <h2>How Reviewer Payout Works</h2>
        <p>Limited-time model: if your review is verified as authentic, you can get up to Rs 40 instantly. If the review is sold, you get the remaining amount from your 50% share after subtracting that instant payout.</p>
      </article>

      <article data-aos="fade-up">
        <h2>Leadership Team</h2>
        <p>AnalyzeG is built by a team of data scientists, engineers, and market researchers dedicated to bringing transparency to consumer insights.</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 2rem;">
          <div style="background: white; border-radius: 12px; padding: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.05); text-align: center; border: 1px solid #f1f5f9;">
            <div style="width: 100px; height: 100px; border-radius: 50%; background: #e2e8f0; margin: 0 auto 1rem; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <h3 style="font-size: 1.25rem; margin-bottom: 0.25rem; color: #1e293b;">Souvik Dey</h3>
            <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1rem;">Founder & CEO</p>
            <a href="https://www.linkedin.com/in/souvikdey1/" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.5rem; color: #0a66c2; text-decoration: none; font-weight: 500; font-size: 0.95rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              Verify on LinkedIn
            </a>
          </div>
        </div>
      </article>

      <article data-aos="fade-up">
        <h2>Contact &amp; Support</h2>
        <p>Have questions about AnalyzeG? We're here to help.</p>
        <ul role="list">
          <li><strong>Email:</strong> support@analyzeg.co.in</li>
          <li><strong>Platform:</strong> <a href="https://analyzeg.netlify.app/" rel="noopener">app.analyzeg.co.in</a></li>
          <li><strong>FAQ:</strong> <a href="analyzeg-faq.html">Frequently Asked Questions</a></li>
        </ul>
      </article>
    </div>
  </section>
  </main>
  <!-- Footer -->
  <SiteFooter />

  <!-- Scripts -->
  <script is:inline src="/js/aos.js"></script>
  <script is:inline src="/js/scripts.js"></script>
  
  <!-- Schema Markup for SEO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "AnalyzeG",
    "url": "https://analyzeg.co.in",
    "logo": "https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png",
    "description": "AnalyzeG is a live verified review platform for trusted insights and dual-stage reviewer payouts.",
    "foundingDate": "2025",
    "serviceType": [
      "Data-Driven Video Review Platform",
      "Authenticated Video Reviews",
      "Review Rewards Program"
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://analyzeg.co.in"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "About",
        "item": "https://analyzeg.co.in/about.html"
      }
    ]
  }
  </script>

</BaseLayout>
