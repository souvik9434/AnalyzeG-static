---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<BaseLayout>
  <Fragment slot="head">
    <title>Consumer Data Intelligence — Verified Video Insights India | AnalyzeG</title>
    <meta name="description" content="AnalyzeG provides consumer data intelligence through verified video reviews. Get demographic-filtered insights, sentiment analysis, and raw CSV with Power BI for Indian brands." />
    <meta name="keywords" content="consumer data intelligence India, consumer insights data, video consumer data, demographic analysis India, sentiment analysis data, customer behavior data, consumer feedback data, review data analytics, consumer intelligence platform" />
    <link rel="canonical" href="https://analyzeg.co.in/solutions/consumer-data" />
    <link rel="alternate" hreflang="en" href="https://analyzeg.co.in/solutions/consumer-data" />
    <link rel="alternate" hreflang="en-IN" href="https://analyzeg.co.in/solutions/consumer-data" />
    <link rel="alternate" hreflang="x-default" href="https://analyzeg.co.in/solutions/consumer-data" />
    <meta property="og:title" content="Consumer Data Intelligence — AnalyzeG" />
    <meta property="og:url" content="https://analyzeg.co.in/solutions/consumer-data" />
    <link is:inline rel="stylesheet" href="/css/styles.css" />
    <link is:inline rel="stylesheet" href="/css/mobile-enhancements.css" />
    <link is:inline rel="stylesheet" href="/css/aos.css" />
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","name":"Consumer Data Intelligence — AnalyzeG","url":"https://analyzeg.co.in/solutions/consumer-data"}</script>
  </Fragment>
  <a href="#main-content" class="skip-link">Skip to main content</a>  <header class="navbar" role="banner"><div class="container"><div class="logo-container"><a href="/" class="logo"><img src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" alt="AnalyzeG" width="40" height="40"><span class="logo-text">AnalyzeG</span></a></div><button class="mobile-menu-btn" aria-label="Toggle nav" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span></button><nav id="main-nav" aria-label="Main navigation" role="navigation" aria-hidden="true"><ul role="menubar"><li role="none"><a href="/" role="menuitem">Home</a></li><li role="none"><a href="/features" role="menuitem">Platform</a></li><li role="none"><a href="/for-reviewers" role="menuitem">For Reviewers</a></li><li role="none"><a href="/about" role="menuitem">About</a></li><li role="none"><a href="/trust" role="menuitem">Trust Center</a></li><li role="none"><a href="https://app.analyzeg.co.in/" class="nav-cta" role="menuitem" rel="noopener">Launch App</a></li></ul></nav></div></header>
  <main id="main-content">
    <section class="page-header" style="padding: 140px 0 60px;"><div class="bg-gradient-animated"></div><div class="container"><p style="color:#93c5fd; font-size:0.85rem; font-weight:600;">SOLUTIONS</p><h1 style="font-size:2.6rem; font-weight:800; color:#fff; margin:0.5rem 0 1rem;">Consumer Data Intelligence</h1><p style="font-size:1.15rem; color:#cbd5e1; max-width:700px;">Demographic-filtered video insights from verified Indian consumers. Raw data you own.</p><div class="header-accent"></div></div></section>
    <section style="background:#fff; padding:60px 0;"><div class="container" style="max-width:900px;">
      <h2 style="font-size:1.8rem; font-weight:700; color:#1e293b; margin-bottom:1.5rem;">Data You Can Actually Use</h2>
      <p style="font-size:1.05rem; color:#475569; line-height:1.8; margin-bottom:2rem;">Most consumer data platforms sell you survey panels or social listening data. AnalyzeG gives you first-party verified video data from real consumers who have actually used your product — with demographic filters for state, age, and gender, and complete raw CSV/Excel export with video links.</p>
      <h2 style="font-size:1.5rem; font-weight:700; color:#1e293b; margin:2rem 0 1rem;">Data Deliverables</h2>
      <div style="display:grid; gap:0.75rem; margin:1.5rem 0;">
        <p style="color:#475569; font-size:1rem;">Raw 30-second video files (MP4) with viewer analytics</p>
        <p style="color:#475569; font-size:1rem;">Power BI dashboard template with pre-built visualizations</p>
        <p style="color:#475569; font-size:1rem;">Sentiment scores (positive/negative/neutral) per video</p>
        <p style="color:#475569; font-size:1rem;">Keyword themes extracted from video content</p>
        <p style="color:#475569; font-size:1rem;">Demographic breakdowns: state, age group, gender</p>
        <p style="color:#475569; font-size:1rem;">Competitor benchmarking data</p>
        <p style="color:#475569; font-size:1rem;">CSV/Excel with video links, scores, and metadata</p>
      </div>
      <div style="background:#f0f9ff; border:1px solid #bfdbfe; border-radius:12px; padding:2rem; margin:2rem 0;"><h3 style="font-size:1.2rem; font-weight:700; color:#1e40af; margin-bottom:0.5rem;">Get Verified Consumer Data</h3><p style="color:#475569; margin-bottom:1rem;">One-time dataset licensing. Final quote after a scoping call — GST invoice, PO, DPA on request.</p><a href="https://cal.com/analyzeg-demo" target="_blank" rel="noopener" style="display:inline-block; background:#2563EB; color:#fff; padding:12px 24px; border-radius:8px; font-weight:600; text-decoration:none;">Book 15-min Demo &rarr;</a></div>
    </div></section>
  </main>
  <SiteFooter />
</BaseLayout>
