---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<BaseLayout>
  <Fragment slot="head">
    <title>Market Research Platform — Video Consumer Insights India | AnalyzeG</title>
    <meta name="description" content="AnalyzeG is a market research platform providing verified video consumer insights for Indian brands. Get Power BI dashboards, sentiment analysis, and raw data in 24h." />
    <meta name="keywords" content="market research India, consumer insights platform, video market research, consumer behavior analysis, brand perception analysis, purchase decision insights, customer sentiment tracking, market research video reviews, consumer data intelligence India" />
    <link rel="canonical" href="https://analyzeg.co.in/solutions/market-research" />
    <link rel="alternate" hreflang="en" href="https://analyzeg.co.in/solutions/market-research" />
    <link rel="alternate" hreflang="en-IN" href="https://analyzeg.co.in/solutions/market-research" />
    <link rel="alternate" hreflang="x-default" href="https://analyzeg.co.in/solutions/market-research" />
    <meta property="og:title" content="Market Research Platform — AnalyzeG" />
    <meta property="og:url" content="https://analyzeg.co.in/solutions/market-research" />
    <link is:inline rel="stylesheet" href="/css/styles.css" />
    <link is:inline rel="stylesheet" href="/css/mobile-enhancements.css" />
    <link is:inline rel="stylesheet" href="/css/aos.css" />
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","name":"Market Research Platform — AnalyzeG","url":"https://analyzeg.co.in/solutions/market-research"}</script>
  </Fragment>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); color: white; padding: 10px 0; text-align: center;"><div class="container"><span style="font-weight: 600; font-size: 0.95rem;">Platform Live Now</span></div></div>
  <header class="navbar" role="banner"><div class="container"><div class="logo-container"><a href="/" class="logo"><img src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" alt="AnalyzeG" width="40" height="40"><span class="logo-text">AnalyzeG</span></a></div><button class="mobile-menu-btn" aria-label="Toggle nav" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span></button><nav id="main-nav" aria-label="Main navigation" role="navigation" aria-hidden="true"><ul role="menubar"><li role="none"><a href="/" role="menuitem">Home</a></li><li role="none"><a href="/features" role="menuitem">Platform</a></li><li role="none"><a href="/for-reviewers" role="menuitem">For Reviewers</a></li><li role="none"><a href="/about" role="menuitem">About</a></li><li role="none"><a href="/trust" role="menuitem">Trust Center</a></li><li role="none"><a href="https://app.analyzeg.co.in/" class="nav-cta" role="menuitem" rel="noopener">Launch App</a></li></ul></nav></div></header>
  <main id="main-content">
    <section class="page-header" style="padding: 140px 0 60px;"><div class="bg-gradient-animated"></div><div class="container"><p style="color:#93c5fd; font-size:0.85rem; font-weight:600;">SOLUTIONS</p><h1 style="font-size:2.6rem; font-weight:800; color:#fff; margin:0.5rem 0 1rem;">Market Research Platform</h1><p style="font-size:1.15rem; color:#cbd5e1; max-width:700px;">Video consumer insights for Indian brands — available in-stock datasets may be delivered in minutes; custom timelines are confirmed in writing.</p><div class="header-accent"></div></div></section>
    <section style="background:#fff; padding:60px 0;"><div class="container" style="max-width:900px;">
      <h2 style="font-size:1.8rem; font-weight:700; color:#1e293b; margin-bottom:1.5rem;">Traditional Research Is Too Slow</h2>
      <p style="font-size:1.05rem; color:#475569; line-height:1.8; margin-bottom:2rem;">Traditional market research takes weeks to months. Focus groups, surveys, and panels produce text data that lacks the visual and emotional context of real consumer experience. By the time the report lands on your desk, the market has moved.</p>
      <h2 style="font-size:1.5rem; font-weight:700; color:#1e293b; margin:2rem 0 1rem;">AnalyzeG: Research in Hours, Not Months</h2>
      <p style="font-size:1.05rem; color:#475569; line-height:1.8; margin-bottom:2rem;">AnalyzeG provides screened 30-second in-hand videos with human moderation, Power BI dashboards, sentiment and keyword themes, demographic filters, and competitor context. Available in-stock datasets may be delivered in minutes, with a 24-hour target; custom timelines are confirmed in writing.</p>
      <h2 style="font-size:1.5rem; font-weight:700; color:#1e293b; margin:2rem 0 1rem;">Research Use Cases</h2>
      <div style="display:grid; gap:0.75rem; margin:1.5rem 0;">
        <p style="color:#475569; font-size:1rem;">Product concept testing with real consumer video feedback</p>
        <p style="color:#475569; font-size:1rem;">Competitor product benchmarking through side-by-side video comparison</p>
        <p style="color:#475569; font-size:1rem;">Brand perception analysis from unscripted consumer reactions</p>
        <p style="color:#475569; font-size:1rem;">Purchase decision insights from in-hand product experience</p>
        <p style="color:#475569; font-size:1rem;">Regional consumer behavior analysis with state-level demographic filters</p>
        <p style="color:#475569; font-size:1rem;">New market entry validation with verified Indian consumer data</p>
      </div>
      <div style="background:#f0f9ff; border:1px solid #bfdbfe; border-radius:12px; padding:2rem; margin:2rem 0;"><h3 style="font-size:1.2rem; font-weight:700; color:#1e40af; margin-bottom:0.5rem;">Start Your Research</h3><p style="color:#475569; margin-bottom:1rem;">Projects starting at ₹5L. Power BI + raw CSV. Final quote after scoping call.</p><a href="https://app.analyzeg.co.in/" style="display:inline-block; background:#2563EB; color:#fff; padding:12px 24px; border-radius:8px; font-weight:600; text-decoration:none;">Launch App &rarr;</a></div>
    </div></section>
  </main>
  <SiteFooter />
</BaseLayout>
