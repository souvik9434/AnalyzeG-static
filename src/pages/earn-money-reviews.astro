---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { AnimatedTimeline } from '../components/AnimatedTimeline';
---
<BaseLayout>
  <Fragment slot="head">
  <title>Earn Money from Video Reviews — AnalyzeG Dual-Stage Payout | Rs 40 Instant + 50% Share</title>
  <meta name="description" content="Earn money with AnalyzeG: submit authentic video reviews, get up to Rs 40 after verification, plus remaining payout from 50% revenue share when sold. No following required. Step-by-step guide." />
  <meta name="keywords" content="earn money video reviews, paid video reviews India, AnalyzeG earn money, video review income, make money from reviews, review monetization platform, dual-stage payout, Rs 40 instant payout, 50% revenue share, earn from product reviews, video review side hustle, authentic review earnings" />
  <link rel="canonical" href="https://analyzeg.co.in/earn-money-reviews.html" />
  <link rel="alternate" hreflang="en" href="https://analyzeg.co.in/earn-money-reviews.html" />
  <link rel="alternate" hreflang="en-IN" href="https://analyzeg.co.in/earn-money-reviews.html" />
  <link rel="alternate" hreflang="x-default" href="https://analyzeg.co.in/earn-money-reviews.html" />

  <!-- Open Graph -->
  <meta property="og:title" content="Earn Money from Video Reviews — AnalyzeG Dual-Stage Payout" />
  <meta property="og:description" content="Get up to Rs 40 instant payout + 50% revenue share. Start earning with authentic video reviews on AnalyzeG." />
  <meta property="og:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
  <meta property="og:image:width" content="1600" />
  <meta property="og:image:height" content="1600" />
  <meta property="og:image:alt" content="Earn money from video reviews on AnalyzeG" />
  <meta property="og:url" content="https://analyzeg.co.in/earn-money-reviews.html" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AnalyzeG" />
  <meta property="og:locale" content="en_IN" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Earn Money from Video Reviews — AnalyzeG" />
  <meta name="twitter:description" content="Get up to Rs 40 after verification + 50% revenue share. Start earning with authentic video reviews." />
  <meta name="twitter:image" content="https://analyzeg.co.in/assets/optimized/logo_nontext_backgrounless.png" />
  <meta name="twitter:image:alt" content="Earn money from video reviews" />
  <meta name="twitter:site" content="@AnalyzeG" />
  <meta name="twitter:creator" content="@AnalyzeG" />

  <!-- Stylesheets -->
  <link is:inline rel="stylesheet" href="/css/styles.css" />
  <link is:inline rel="stylesheet" href="/css/mobile-enhancements.css" />
  <link is:inline rel="stylesheet" href="/css/aos.css" />
  </Fragment>

  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div style="background: linear-gradient(135deg, #2563EB 0%, #1e40af 100%); color: white; padding: 10px 0; text-align: center; position: relative; z-index: 10;">
    <div class="container">
      <span style="font-weight: 600; font-size: 0.95rem;">Platform Live Now</span>
    </div>
  </div>

  <!-- Navigation -->
  <header class="navbar" role="banner">
    <div class="container">
      <div class="logo-container">
        <a href="/" class="logo">
          <img src="/assets/optimized/192X192_ONLYLOGO_BACKGROUNDLESS.svg" alt="AnalyzeG" width="40" height="40">
          <span class="logo-text">AnalyzeG</span>
        </a>
      </div>
      <button class="mobile-menu-btn" 
              aria-label="Toggle navigation menu" 
              aria-expanded="false"
              aria-controls="main-nav"
              aria-haspopup="true">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav id="main-nav" 
           aria-label="Main navigation"
           role="navigation"
           aria-hidden="true">
        <ul role="menubar">
          <li role="none"><a href="/" role="menuitem">Home</a></li>
          <li role="none"><a href="features.html" role="menuitem">Features</a></li>
          <li role="none"><a href="about.html" role="menuitem">About</a></li>
          <li role="none"><a href="earn-money-reviews.html" class="active" role="menuitem" aria-current="page">Earn Money</a></li>
          <li role="none"><a href="analyzeg-faq.html" role="menuitem">FAQ</a></li>
          <li role="none"><a href="https://analyzeg.netlify.app/" data-app-href="/" class="nav-cta" role="menuitem" rel="noopener"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg> Launch App</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main id="main-content">
  <!-- Hero Section -->
  <section class="page-header" data-aos="fade-in">
    <div class="bg-gradient-animated"></div>
    <div class="animated-objects">      <div class="bg-object hexagon" style="top: 10%; left: 80%; --moveX: 20vw; --moveY: -25vh; animation-delay: 0.4s; background: #F59E0B;"></div>
      <div class="bg-object circle" style="top: 65%; left: 15%; --moveX: -25vw; --moveY: 25vh; animation-delay: 0.9s; background: #8B5CF6;"></div>
      <div class="bg-object triangle" style="top: 25%; left: 40%; --moveX: 30vw; --moveY: 15vh; animation-delay: 1.4s; background: #10B981;"></div>
        </div>    <div class="container">
      <h1 data-aos="zoom-in" data-aos-delay="200">Earn with Authentic Video Reviews</h1>
      <p data-aos="fade-up" data-aos-delay="400">Live now: get up to Rs 40 after verification, then get the remaining payout from your 50% share when your review is sold.</p>
      <div class="header-accent"></div>
    </div>
  </section>

  <!-- Earnings Information -->
  <section class="earnings-info">
    <div class="container">
      <div class="earnings-grid">        <div class="earnings-card" data-aos="fade-up">
          <div class="earnings-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M16 8l-8 8"></path>
              <path d="M8 8l8 8"></path>
            </svg>
          </div>
          <h2>Limited-Time Instant + Sale Payout</h2>
          <p>After your review is verified as authentic, you can get up to Rs 40 instantly. When your review is sold, you get the remaining amount from your 50% share after subtracting the instant payout.</p>
        </div>
        
        <div class="earnings-card" data-aos="fade-up" data-aos-delay="100">
          <div class="earnings-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h2>Smart Verification</h2>
          <p>Our secure checks verify identity and review authenticity quickly. Verified reviews become eligible for instant payout and sale payout.</p>
        </div>
        
        <div class="earnings-card" data-aos="fade-up" data-aos-delay="200">
          <div class="earnings-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <h2>Multiple Earnings</h2>
          <p>Submit reviews for multiple products to increase your total earnings over time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="how-it-works" id="how-it-works">
    <div class="container">
      <h2 class="section-title" data-aos="fade-up">How to Start Earning</h2>
      <p class="section-intro" data-aos="fade-up">Our streamlined process makes it easy to earn rewards for your authentic video reviews. Follow these simple steps:</p>
      
      <AnimatedTimeline client:only="react">
      <div class="process-steps">
        <div class="process-step" data-aos="fade-up">
          <div class="step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <div class="step-content">
            <h3>1. Create Your Profile</h3>
            <p>Set up your account in minutes and unlock review opportunities.</p>
            <ul>
              <li>Sign up with basic information</li>
              <li>Verify your identity securely</li>
              <li>Set up payment preferences</li>
            </ul>
          </div>
        </div>
        
        <div class="process-step" data-aos="fade-up" data-aos-delay="100">
          <div class="step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div class="step-content">
            <h3>2. Record Your Review</h3>
            <p>Share your honest opinion about products through video reviews.</p>
            <ul>
              <li>Choose from available review opportunities</li>
              <li>Record a 2-5 minute video review</li>
              <li>Answer quick survey questions</li>
            </ul>
          </div>
        </div>
        
        <div class="process-step" data-aos="fade-up" data-aos-delay="200">
          <div class="step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="step-content">
            <h3>3. Get Verified & Paid</h3>
            <p>Get verified fast and start receiving payouts in two stages.</p>
            <ul>
              <li>Automatic multi-factor verification</li>
              <li>Up to Rs 40 instant payout after verification</li>
              <li>Remaining payout from your 50% share when sold</li>
            </ul>
          </div>
        </div>
        
        <div class="process-step" data-aos="fade-up" data-aos-delay="300">
          <div class="step-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
              <line x1="9" y1="9" x2="9.01" y2="9"></line>
              <line x1="15" y1="9" x2="15.01" y2="9"></line>
            </svg>
          </div>
          <div class="step-content">
            <h3>4. Earn Recurring Rewards</h3>
            <p>Continue earning as your reviews help businesses and consumers.</p>
            <ul>
              <li>Earn bonuses for high-quality reviews</li>
              <li>Unlock premium review opportunities</li>
              <li>Build your reviewer reputation score</li>
            </ul>
          </div>
        </div>
      </div>
      </AnimatedTimeline>
      
      <div class="cta-container" data-aos="fade-up">
        <a href="https://analyzeg.netlify.app/b2c-auth" data-app-href="/b2c-auth" class="btn-primary" rel="noopener">Start Earning Today</a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-section">
    <div class="container">
      <h2 class="section-title" data-aos="fade-up">Common Questions</h2>
      <div class="faq-grid">
        <div class="faq-item" data-aos="fade-up">
          <h3>How much can I earn?</h3>
          <p>Limited-time model: get up to Rs 40 after verification. If the review is sold, you get the remaining amount from your 50% share after subtracting that instant payout.</p>
        </div>
        
        <div class="faq-item" data-aos="fade-up" data-aos-delay="100">
          <h3>When do I get paid?</h3>
          <p>You can receive up to Rs 40 soon after verification. The remaining payout is processed when your review is sold. Payment options include UPI and bank transfer.</p>
        </div>
        
        <div class="faq-item" data-aos="fade-up" data-aos-delay="200">
          <h3>What equipment do I need?</h3>
          <p>Just a smartphone with a decent camera and stable internet connection. We provide guidelines for optimal video quality.</p>
        </div>
        
        <div class="faq-item" data-aos="fade-up" data-aos-delay="300">
          <h3>How is authenticity verified?</h3>
          <p>Our advanced verification system validates your identity and review authenticity through multiple security checks. This ensures fair rewards and maintains trust in the platform.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta" data-aos="fade-up">
    <div class="container">
      <h2>Ready to Start Earning?</h2>
      <p>Join now and start with the limited-time dual-stage payout model for honest reviews.</p>
      <div class="cta-buttons">
        <a href="https://analyzeg.netlify.app/b2c-auth" data-app-href="/b2c-auth" class="btn-primary" rel="noopener">Sign Up &amp; Start Now</a>
        <a href="analyzeg-faq.html" class="btn-secondary">Learn More</a>
      </div>
    </div>
  </section>
  </main>
  <!-- Footer -->
  <SiteFooter />
  <!-- Scripts -->
  <script is:inline src="/js/aos.js"></script>
  <script is:inline src="/js/scripts.js"></script>

  <!-- HowTo Schema (earns How-To rich results) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Earn Money from Video Reviews on AnalyzeG",
    "description": "Step-by-step guide to earning money through authentic video reviews on AnalyzeG with dual-stage payout: up to Rs 40 instant + 50% revenue share.",
    "totalTime": "PT30M",
    "estimatedCost": {
      "@type": "MonetaryAmount",
      "currency": "INR",
      "value": "0"
    },
    "supply": [
      {
        "@type": "HowToSupply",
        "name": "Smartphone with camera"
      },
      {
        "@type": "HowToSupply",
        "name": "Stable internet connection"
      }
    ],
    "step": [
      {
        "@type": "HowToStep",
        "name": "Create your AnalyzeG profile",
        "text": "Sign up on AnalyzeG, complete your profile verification, and set up your payment preferences including UPI or bank transfer.",
        "url": "https://analyzeg.co.in/earn-money-reviews.html#step-1"
      },
      {
        "@type": "HowToStep",
        "name": "Record your video review",
        "text": "Choose from available review opportunities, record a 2-5 minute authentic video review following AnalyzeG's quality guidelines.",
        "url": "https://analyzeg.co.in/earn-money-reviews.html#step-2"
      },
      {
        "@type": "HowToStep",
        "name": "Get verified and paid",
        "text": "Submit your review for multi-factor verification. After verification, get up to Rs 40 instantly. When your review is sold, receive the remaining payout from your 50% share.",
        "url": "https://analyzeg.co.in/earn-money-reviews.html#step-3"
      }
    ]
  }
  </script>

  <!-- WebPage Schema with Speakable -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://analyzeg.co.in/earn-money-reviews.html/#webpage",
    "name": "Earn Money from Video Reviews — AnalyzeG Dual-Stage Payout",
    "url": "https://analyzeg.co.in/earn-money-reviews.html",
    "description": "Earn money with AnalyzeG: submit authentic video reviews, get up to Rs 40 after verification, plus remaining payout from 50% revenue share.",
    "datePublished": "2025-12-01",
    "dateModified": "2026-08-27",
    "isPartOf": {
      "@id": "https://analyzeg.co.in/#website"
    },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": ["h1", ".earnings-card h2", ".step-content h3"]
    }
  }
  </script>

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://analyzeg.co.in"},
      {"@type": "ListItem", "position": 2, "name": "Earn with Reviews", "item": "https://analyzeg.co.in/earn-money-reviews.html"}
    ]
  }
  </script>

</BaseLayout>
